{% comment %}
  PDP Items Remaining Stock Banner Block
  Displays remaining stock urgency in a pill shape pink/red card matching user design.
  Items remaining count randomizes on every refresh for realistic dynamic scarcity.
{% endcomment %}

{% liquid
  assign target_product = product | default: closest.product
  assign product_id = target_product.id | default: section.id | default: 'main'
  assign current_variant = target_product.selected_or_first_available_variant
  assign inventory_qty = current_variant.inventory_quantity
  
  if inventory_qty == blank or inventory_qty <= 0
    assign inventory_qty = block.settings.fallback_stock_count | default: 35
  endif
%}

<div class="pdp-items-banner" {{ block.shopify_attributes }}>
  <div class="pdp-items-banner__card">
    <div class="pdp-items-banner__content">
      <span class="pdp-items-banner__icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Back orange bag -->
          <rect x="9" y="8" width="11" height="13" rx="1.5" fill="#FB923C"/>
          <path d="M12 8V6C12 4.9 12.9 4 14 4H15C16.1 4 17 4.9 17 6V8" stroke="#EA580C" stroke-width="1.6" stroke-linecap="round"/>
          <!-- Front blue bag -->
          <rect x="4" y="6" width="11" height="14" rx="1.5" fill="#38BDF8"/>
          <path d="M6.5 6V4.5C6.5 3.4 7.4 2.5 8.5 2.5H10.5C11.6 2.5 12.5 3.4 12.5 4.5V6" stroke="#0284C7" stroke-width="1.6" stroke-linecap="round"/>
          <line x1="6" y1="10" x2="13" y2="10" stroke="#0EA5E9" stroke-width="1" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="pdp-items-banner__text">
        Hurry up! Just <strong class="pdp-items-banner__highlight"><span id="PdpItemsStockCount-{{ product_id }}">{{ inventory_qty }}</span> Only few items are left</strong>
      </span>
    </div>
    <span class="pdp-items-banner__arrow" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </span>
  </div>
</div>

{% style %}
  .pdp-items-banner {
    width: 100%;
    margin-top: 6px;
    margin-bottom: 6px;
  }

  .pdp-items-banner__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background-color: #FFF0F2;
    border: 1px solid #FFD6DC;
    border-radius: 50px;
    gap: 10px;
  }

  .pdp-items-banner__content {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }

  .pdp-items-banner__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pdp-items-banner__text {
    font-family: var(--font-body--family, sans-serif);
    font-size: 13px;
    color: #E53E3E;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pdp-items-banner__highlight {
    font-weight: 700;
    color: #E53E3E;
  }

  .pdp-items-banner__arrow {
    display: flex;
    align-items: center;
    color: #E53E3E;
    flex-shrink: 0;
  }

  @media screen and (max-width: 600px) {
    .pdp-items-banner__card {
      padding: 8px 12px;
    }
    .pdp-items-banner__text {
      font-size: 11.5px;
      white-space: normal;
    }
  }
{% endstyle %}

<script>
  (function() {
    var stockEl = document.getElementById('PdpItemsStockCount-{{ product_id }}');
    if (!stockEl) return;
    
    // Pick random items remaining count between 9 and 39 on each refresh
    var randomStock = Math.floor(Math.random() * (39 - 9 + 1)) + 9;
    stockEl.textContent = randomStock;
  })();
</script>
