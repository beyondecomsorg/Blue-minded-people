{%- doc -%}
  This snippet is used to render a product card.
  It renders a premium structured layout with fabric badges, wishlist button, quick view overlay, color swatches, reviews, prices, and an AJAX Add to Cart CTA.

  @param {object} product - The product object
  @param {object} [block] - The block object
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign product_form_id = 'product-form-' | append: section.id | append: '-' | append: product.id
  assign variant_to_link = product.selected_or_first_available_variant

  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif
%}

<product-card
  class="product-card product-card--premium"
  data-product-id="{{ product.id }}"
  id="product-card-{{ product.id }}"
  {{ block.shopify_attributes }}
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
>
  <!-- Main product link area -->
  <a
    href="{{ variant_to_link.url }}"
    class="product-card__link"
    ref="productCardLink"
    aria-label="{{ product.title }}"
  >
  </a>

  <!-- Image and overlays wrapper -->
  <div class="product-card__image-container">
    {% capture gallery_children %}
      {% unless onboarding %}
        <!-- Badge (top-left overlay) -->
        {% if product.metafields.custom.fabric_badge != blank %}
          <div class="product-card__badge product-card__badge--fabric">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 3.5 1 9.8a7 7 0 0 1-9 8.2z"/>
              <path d="M9 22v-4"/>
            </svg>
            <span>{{ product.metafields.custom.fabric_badge }}</span>
          </div>
        {% endif %}

        <!-- Wishlist icon (top-right overlay) -->
        <div class="product-card__wishlist">
          {% render 'hulkapps-wishlist-collection-btn', productId: product.id, variantId: product.selected_or_first_available_variant.id %}
        </div>

        <!-- Quick View Overlay (bottom center) -->
        <quick-add-component
          class="product-card__quick-add"
          ref="quickAdd"
          data-product-title="{{ product.title }}"
          data-quick-add-button="choose"
          data-product-options-count="{{ product.options.size }}"
        >
          <button
            class="product-card__quick-view-btn"
            type="button"
            on:click="quick-add-component/handleClick"
            aria-label="Quick View {{ product.title }}"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <span>Quick View</span>
          </button>
        </quick-add-component>
      {% endunless %}
    {% endcapture %}

    {% render 'card-gallery', children: gallery_children, product: product, block: block %}
  </div>

  <!-- Body Content -->
  <div class="product-card__info">
    {% unless onboarding %}
      <!-- Color Swatches Row -->
      {% liquid
        assign has_color_options = false
        for product_option in product.options_with_values
          assign option_name_downcase = product_option.name | downcase
          if option_name_downcase == 'color' or option_name_downcase == 'colour'
            assign has_color_options = true
          endif
        endfor
      %}

      {% if has_color_options %}
        <div class="product-card__swatches-row">
          <swatches-variant-picker-component
            data-product-id="{{ product.id }}"
            data-product-url="{{ product.url }}"
            ref="swatchesVariantPicker"
          >
            <form>
              {%- for product_option in product.options_with_values -%}
                {%- liquid
                  assign option_name_downcase = product_option.name | downcase
                  if option_name_downcase != 'color' and option_name_downcase != 'colour'
                    continue
                  endif
                  assign swatch_option_position = product_option.position
                  assign swatch_option_key = 'option' | append: swatch_option_position
                -%}

                <fieldset class="variant-option variant-option--buttons variant-option--swatches">
                  {% capture swatch_items %}
                    {%- assign swatch_rendered_count = 0 -%}
                    {%- assign added_colors = ',' -%}
                    {%- for val in product_option.values -%}
                      {%- assign added_colors = added_colors | append: val.name | downcase | strip | append: ',' -%}
                    {%- endfor -%}
                    
                    {%- for product_option_value in product_option.values -%}
                      {%- if swatch_rendered_count < 4 -%}
                        {% liquid
                          assign featured_media = product_option_value.variant.featured_media
                          assign child_product = nil

                          if featured_media == blank
                            if product_option_value.product_url
                              assign child_product = product_option_value.variant.product
                            endif

                            if child_product
                              assign featured_media = child_product.featured_media
                            elsif product_option_value.variant == blank
                              for variant in product.variants
                                if variant.available and variant[swatch_option_key] == product_option_value.name and variant.featured_media
                                  assign featured_media = variant.featured_media
                                  assign first_available_variant = variant
                                  break
                                endif
                              endfor
                            endif
                          endif
                        %}

                        <li class="variant-option__swatch">
                          <label
                            data-media-id="{{ featured_media.id }}"
                            class="variant-option__button-label variant-option__button-label--has-swatch"
                            on:pointerenter="product-card/previewVariant/{{ featured_media.id }}"
                            on:pointerleave="product-card/resetVariant"
                          >
                            <input
                              type="radio"
                              name="{{ product_option.name | escape }}-{{ product.id }}-swatch"
                              value="{{ product_option_value | escape }}"
                              aria-label="{{ product_option_value.name }}"
                              data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                              data-option-media-id="{{ featured_media.id }}"
                              data-option-value-id="{{ product_option_value.id }}"
                              data-option-available="{{ product_option_value.available }}"
                              data-connected-product-url="{{ product_option_value.product_url }}"
                              data-variant-id="{{ first_available_variant.id | default: product_option_value.variant.id }}"
                              data-first-available-or-first-variant-id="{{ first_available_variant.id | default: product_option_value.variant.id }}"
                            >
                            {% render 'swatch',
                              swatch: product_option_value.swatch,
                              variant_image: featured_media,
                              value: product_option_value.name
                            %}
                            {% render 'strikethrough-variant', product_option: product_option_value %}
                          </label>
                        </li>
                      {%- endif -%}
                      {%- assign swatch_rendered_count = swatch_rendered_count | plus: 1 -%}
                    {%- endfor -%}
                    
                    {%- assign linked_products = blank -%}
                    {%- unless onboarding -%}
                      {%- assign linked_products = product.metafields.custom.product_variant_metafield.value -%}
                    {%- endunless -%}
                    {%- if linked_products != blank -%}
                      {%- for linked_product in linked_products -%}
                        {%- if linked_product != blank and linked_product.handle != blank -%}
                          {%- for option in linked_product.options_with_values -%}
                            {%- assign opt_name_downcase = option.name | downcase -%}
                            {%- if opt_name_downcase == 'color' or opt_name_downcase == 'colour' -%}
                              {%- for val in option.values -%}
                                {%- assign color_key = ',' | append: val.name | downcase | strip | append: ',' -%}
                                {%- unless added_colors contains color_key -%}
                                  {%- assign added_colors = added_colors | append: val.name | downcase | strip | append: ',' -%}
                                  {%- if swatch_rendered_count < 4 -%}
                                    {%- assign variant_url = val.variant.url | default: linked_product.url -%}
                                    <li class="variant-option__swatch">
                                      <a
                                        href="{{ variant_url }}"
                                        class="variant-option__button-label variant-option__button-label--has-swatch"
                                        aria-label="{{ val.name | escape }}"
                                        style="text-decoration: none;"
                                      >
                                        {% render 'swatch',
                                          swatch: val.swatch,
                                          value: val.name
                                        %}
                                      </a>
                                    </li>
                                  {%- endif -%}
                                  {%- assign swatch_rendered_count = swatch_rendered_count | plus: 1 -%}
                                {%- endunless -%}
                              {%- endfor -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    {% if swatch_rendered_count > 4 %}
                      {% assign overflow_count = swatch_rendered_count | minus: 4 %}
                      <li class="variant-option__swatch-overflow-count">
                        +{{ overflow_count }}
                      </li>
                    {% endif %}
                  {% endcapture %}

                  {% render 'overflow-list', children: swatch_items, ref: 'overflowList' %}
                </fieldset>
              {%- endfor -%}
            </form>
          </swatches-variant-picker-component>
        </div>
      {% endif %}

      <!-- Product Title -->
      <h3 class="product-card__title">
        <a href="{{ variant_to_link.url }}">
          {{ product.title }}
        </a>
      </h3>


      <!-- Price Row -->
      <div class="product-card__price-row">
        <span class="product-card__price">{{ product.price | default: 0 | money_without_trailing_zeros }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="product-card__compare-price">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
          {% liquid
            assign diff = product.compare_at_price | minus: product.price
            assign discount = diff | times: 100 | divided_by: product.compare_at_price | round
          %}
          <span class="product-card__discount">{{ discount }}% OFF</span>
        {% endif %}
      </div>

      <!-- AJAX Add to Cart CTA Button -->
      <div class="product-card__cta-row">
        <product-form-component
          data-section-id="{{ section.id }}"
          data-product-id="{{ product.id }}"
          on:submit="/handleSubmit"
          class="product-card__form-component"
        >
          {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input
              type="hidden"
              name="id"
              value="{{ variant_to_link.id }}"
            >
            <input
              type="hidden"
              name="quantity"
              value="1"
            >
            <button
              class="product-card__atc-btn"
              type="submit"
              {% unless product.available %}
                disabled
              {% endunless %}
            >
              {% if product.available %}
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="product-card__atc-icon">
                  <circle cx="9" cy="21" r="1"/>
                  <circle cx="20" cy="21" r="1"/>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
                <span>Add to Cart</span>
              {% else %}
                <span>Sold Out</span>
              {% endif %}
            </button>
          {%- endform -%}
        </product-form-component>
      </div>

    {% else %}
      <!-- Onboarding state -->
      <h3 class="product-card__title">
        <a href="#">{{ 'content.product_card_placeholder' | t }}</a>
      </h3>
      <div class="product-card__price-row">
        <span class="product-card__price">{{ 9900 | money_without_trailing_zeros }}</span>
      </div>
    {% endunless %}
  </div>
</product-card>
