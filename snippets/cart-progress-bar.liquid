{%- doc -%}
  Renders the tiered rewards & free shipping offer section for the cart drawer.
  Updated based on client requirements:
  - Free Shipping on all orders (no minimum cart threshold)
  - Buy 2 -> +5% OFF
  - Buy 3 -> +10% OFF
  - Dynamic milestone logic based on total cart item quantity (cart.item_count)
{%- enddoc -%}

{%- liquid
  assign enabled = settings.cart_progress_bar_enable
  if enabled == nil
    assign enabled = true
  endif

  assign show_empty = settings.cart_progress_bar_show_empty
  if show_empty == nil
    assign show_empty = true
  endif

  if enabled == false
    break
  endif

  if cart.empty? and show_empty == false
    break
  endif

  assign item_count = cart.item_count | default: 0

  # Milestone labels & icons
  assign tier1_label = settings.cart_progress_bar_tier1_label
  if tier1_label == blank
    assign tier1_label = 'FREE SHIPPING'
  endif
  assign tier1_sublabel = settings.cart_progress_bar_tier1_sublabel
  if tier1_sublabel == blank
    assign tier1_sublabel = 'ALL ORDERS'
  endif
  assign tier1_icon = settings.cart_progress_bar_tier1_icon | default: 'truck'

  assign tier2_label = settings.cart_progress_bar_tier2_label
  if tier2_label == blank
    assign tier2_label = 'BUY 2'
  endif
  assign tier2_sublabel = settings.cart_progress_bar_tier2_sublabel
  if tier2_sublabel == blank
    assign tier2_sublabel = '+5% OFF'
  endif
  assign tier2_icon = settings.cart_progress_bar_tier2_icon | default: 'tag'

  assign tier3_label = settings.cart_progress_bar_tier3_label
  if tier3_label == blank
    assign tier3_label = 'BUY 3'
  endif
  assign tier3_sublabel = settings.cart_progress_bar_tier3_sublabel
  if tier3_sublabel == blank
    assign tier3_sublabel = '+10% OFF'
  endif
  assign tier3_icon = settings.cart_progress_bar_tier3_icon | default: 'percent'

  # Dynamic messages
  assign msg_empty = settings.cart_progress_bar_msg_empty
  if msg_empty == blank
    assign msg_empty = 'FREE SHIPPING ON ALL ORDERS'
  endif

  assign msg_tier1 = settings.cart_progress_bar_msg_tier1
  if msg_tier1 == blank
    assign msg_tier1 = 'Add 1 more product to unlock 5% OFF'
  endif

  assign msg_tier2 = settings.cart_progress_bar_msg_tier2
  if msg_tier2 == blank
    assign msg_tier2 = 'Buy 1 more product to unlock 10% OFF'
  endif

  assign msg_completed = settings.cart_progress_bar_completed_msg
  if msg_completed == blank
    assign msg_completed = 'You unlocked 10% OFF 🎉'
  endif

  # Determine unlocked milestones (based on total cart item quantity cart.item_count)
  assign tier1_unlocked = false
  assign tier2_unlocked = false
  assign tier3_unlocked = false

  if item_count >= 1
    assign tier1_unlocked = true
  endif
  if item_count >= 2
    assign tier2_unlocked = true
  endif
  if item_count >= 3
    assign tier3_unlocked = true
  endif

  # Progress bar fill percentage
  assign progress_pct = 0
  if item_count == 1
    assign progress_pct = 25
  elsif item_count == 2
    assign progress_pct = 50
  elsif item_count >= 3
    assign progress_pct = 100
  endif

  # Current message
  if item_count == 0
    assign active_msg = msg_empty
  elsif item_count == 1
    assign active_msg = msg_tier1
  elsif item_count == 2
    assign active_msg = msg_tier2
  else
    assign active_msg = msg_completed
  endif

  # Colors & Styling
  assign card_bg = settings.cart_progress_bar_card_bg
  if card_bg == blank
    assign card_bg = '#FFFFFF'
  endif

  assign card_border = settings.cart_progress_bar_card_border
  if card_border == blank
    assign card_border = '#EBE7DF'
  endif

  assign text_color = settings.cart_progress_bar_text_color
  if text_color == blank
    assign text_color = '#0B1F33'
  endif

  assign highlight_color = settings.cart_progress_bar_highlight_color
  if highlight_color == blank
    assign highlight_color = '#15803D'
  endif

  assign track_color = settings.cart_progress_bar_track_color
  if track_color == blank
    assign track_color = '#E5E7EB'
  endif

  assign fill_color = settings.cart_progress_bar_fill_color
  if fill_color == blank
    assign fill_color = '#0B1F33'
  endif

  assign active_circle_bg = settings.cart_progress_bar_active_circle_bg
  if active_circle_bg == blank
    assign active_circle_bg = '#0B1F33'
  endif

  assign active_circle_text = settings.cart_progress_bar_active_circle_text
  if active_circle_text == blank
    assign active_circle_text = '#FFFFFF'
  endif

  assign inactive_circle_bg = settings.cart_progress_bar_inactive_circle_bg
  if inactive_circle_bg == blank
    assign inactive_circle_bg = '#FFFFFF'
  endif

  assign inactive_circle_border = settings.cart_progress_bar_inactive_circle_border
  if inactive_circle_border == blank
    assign inactive_circle_border = '#CBD5E1'
  endif

  assign inactive_circle_text = settings.cart_progress_bar_inactive_circle_text
  if inactive_circle_text == blank
    if inactive_circle_bg != blank and inactive_circle_bg != '#ffffff' and inactive_circle_bg != '#FFFFFF' and inactive_circle_bg != 'transparent'
      assign inactive_circle_text = '#FFFFFF'
    else
      assign inactive_circle_text = '#8898AA'
    endif
  endif
-%}

<cart-progress-bar
  class="cart-progress-bar-wrapper"
  data-hydration-key="cart-progress-bar"
  data-cart-item-count="{{ item_count }}"
  data-msg-empty="{{ msg_empty | escape }}"
  data-msg-tier1="{{ msg_tier1 | escape }}"
  data-msg-tier2="{{ msg_tier2 | escape }}"
  data-msg-completed="{{ msg_completed | escape }}"
  style="
    --cpb-card-bg: {{ card_bg }};
    --cpb-card-border: {{ card_border }};
    --cpb-text-color: {{ text_color }};
    --cpb-highlight-color: {{ highlight_color }};
    --cpb-track-color: {{ track_color }};
    --cpb-fill-color: {{ fill_color }};
    --cpb-active-circle-bg: {{ active_circle_bg }};
    --cpb-active-circle-text: {{ active_circle_text }};
    --cpb-inactive-circle-bg: {{ inactive_circle_bg }};
    --cpb-inactive-circle-border: {{ inactive_circle_border }};
    --cpb-inactive-circle-text: {{ inactive_circle_text }};
    --cpb-progress-width: {{ progress_pct }}%;
  "
>
  <div class="cart-progress-bar__card">
    <div class="cart-progress-bar__message" role="status" aria-live="polite">
      {{ active_msg }}
    </div>

    <div class="cart-progress-bar__timeline">
      <div class="cart-progress-bar__track">
        <div class="cart-progress-bar__fill">
          <span class="cart-progress-bar__needle-dot"></span>
        </div>
      </div>

      <div class="cart-progress-bar__milestones">
        {%- # Milestone 1: Free Shipping on all orders -%}
        <div class="cart-progress-bar__milestone milestone-1{% if tier1_unlocked %} is-unlocked{% endif %}">
          <div class="cart-progress-bar__circle" title="{{ tier1_label }}" style="{% if tier1_unlocked %}background-color: #0B1F33 !important; border-color: #0B1F33 !important; color: #FFFFFF !important;{% endif %}">
            {%- case tier1_icon -%}
              {%- when 'tag' -%}
                <svg class="cart-progress-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{% if tier1_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="{% if tier1_unlocked %}color: #FFFFFF !important; stroke: #FFFFFF !important; fill: none !important;{% endif %}"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" fill="none" stroke="{% if tier1_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier1_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></path><line x1="7" y1="7" x2="7.01" y2="7" stroke="{% if tier1_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier1_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important;{% endif %}"></line></svg>
              {%- when 'percent' -%}
