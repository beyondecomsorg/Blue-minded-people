              {%- when 'gift' -%}
                <svg class="cart-progress-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{% if tier1_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="{% if tier1_unlocked %}color: #FFFFFF !important; stroke: #FFFFFF !important; fill: none !important;{% endif %}"><polyline points="20 12 20 22 4 22 4 12" fill="none" stroke="{% if tier1_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier1_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></polyline><rect x="2" y="7" width="20" height="5" fill="none" stroke="{% if tier1_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier1_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></rect><line x1="12" y1="22" x2="12" y2="7" stroke="{% if tier1_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier1_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important;{% endif %}"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z" fill="none" stroke="{% if tier1_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier1_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" fill="none" stroke="{% if tier1_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier1_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></path></svg>
              {%- else -%}
