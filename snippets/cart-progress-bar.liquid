              {%- when 'percent' -%}
                <svg class="cart-progress-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{% if tier2_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="{% if tier2_unlocked %}color: #FFFFFF !important; stroke: #FFFFFF !important; fill: none !important;{% endif %}"><line x1="19" y1="5" x2="5" y2="19" stroke="{% if tier2_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier2_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important;{% endif %}"></line><circle cx="6.5" cy="6.5" r="2.5" fill="none" stroke="{% if tier2_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier2_unlocked %}stroke: #FFFFFF !important; fill: none !important; color: #FFFFFF !important;{% endif %}"></circle><circle cx="17.5" cy="17.5" r="2.5" fill="none" stroke="{% if tier2_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier2_unlocked %}stroke: #FFFFFF !important; fill: none !important; color: #FFFFFF !important;{% endif %}"></circle></svg>
              {%- when 'gift' -%}
                <svg class="cart-progress-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{% if tier2_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="{% if tier2_unlocked %}color: #FFFFFF !important; stroke: #FFFFFF !important; fill: none !important;{% endif %}"><polyline points="20 12 20 22 4 22 4 12" fill="none" stroke="{% if tier2_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier2_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></polyline><rect x="2" y="7" width="20" height="5" fill="none" stroke="{% if tier2_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier2_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></rect><line x1="12" y1="22" x2="12" y2="7" stroke="{% if tier2_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier2_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important;{% endif %}"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z" fill="none" stroke="{% if tier2_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier2_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" fill="none" stroke="{% if tier2_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier2_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></path></svg>
              {%- else -%}
                <svg class="cart-progress-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{% if tier2_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="{% if tier2_unlocked %}color: #FFFFFF !important; stroke: #FFFFFF !important; fill: none !important;{% endif %}"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" fill="none" stroke="{% if tier2_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier2_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></path><line x1="7" y1="7" x2="7.01" y2="7" stroke="{% if tier2_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier2_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important;{% endif %}"></line></svg>
            {%- endcase -%}
          </div>
          <span class="cart-progress-bar__label">{{ tier2_label }}</span>
          <span class="cart-progress-bar__target">{{ tier2_sublabel }}</span>
        </div>

        {%- # Milestone 3: Buy 3 -> +10% OFF -%}
        <div class="cart-progress-bar__milestone milestone-3{% if tier3_unlocked %} is-unlocked{% endif %}{% if item_count >= 3 %} is-active{% endif %}">
          <div class="cart-progress-bar__circle" title="{{ tier3_label }}" style="{% if tier3_unlocked %}background-color: #0B1F33 !important; border-color: #0B1F33 !important; color: #FFFFFF !important;{% endif %}">
            {%- case tier3_icon -%}
              {%- when 'truck' -%}
                <svg class="cart-progress-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="{% if tier3_unlocked %}color: #FFFFFF !important; stroke: #FFFFFF !important; fill: none !important;{% endif %}"><rect x="1" y="3" width="15" height="13" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; fill: none !important; color: #FFFFFF !important;{% endif %}"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 8" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; fill: none !important; color: #FFFFFF !important;{% endif %}"></polygon><circle cx="5.5" cy="18.5" r="2.5" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; fill: none !important; color: #FFFFFF !important;{% endif %}"></circle><circle cx="18.5" cy="18.5" r="2.5" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; fill: none !important; color: #FFFFFF !important;{% endif %}"></circle></svg>
              {%- when 'tag' -%}
                <svg class="cart-progress-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="{% if tier3_unlocked %}color: #FFFFFF !important; stroke: #FFFFFF !important; fill: none !important;{% endif %}"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></path><line x1="7" y1="7" x2="7.01" y2="7" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important;{% endif %}"></line></svg>
              {%- when 'gift' -%}
                <svg class="cart-progress-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="{% if tier3_unlocked %}color: #FFFFFF !important; stroke: #FFFFFF !important; fill: none !important;{% endif %}"><polyline points="20 12 20 22 4 22 4 12" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></polyline><rect x="2" y="7" width="20" height="5" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></rect><line x1="12" y1="22" x2="12" y2="7" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important;{% endif %}"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important; fill: none !important;{% endif %}"></path></svg>
              {%- else -%}
                <svg class="cart-progress-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="{% if tier3_unlocked %}color: #FFFFFF !important; stroke: #FFFFFF !important; fill: none !important;{% endif %}"><line x1="19" y1="5" x2="5" y2="19" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; color: #FFFFFF !important;{% endif %}"></line><circle cx="6.5" cy="6.5" r="2.5" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; fill: none !important; color: #FFFFFF !important;{% endif %}"></circle><circle cx="17.5" cy="17.5" r="2.5" fill="none" stroke="{% if tier3_unlocked %}#FFFFFF{% else %}currentColor{% endif %}" style="{% if tier3_unlocked %}stroke: #FFFFFF !important; fill: none !important; color: #FFFFFF !important;{% endif %}"></circle></svg>
            {%- endcase -%}
          </div>
          <span class="cart-progress-bar__label">{{ tier3_label }}</span>
          <span class="cart-progress-bar__target">{{ tier3_sublabel }}</span>
        </div>
      </div>
    </div>

    {%- # Unlocked Coupon Card -%}
    {%- assign active_coupon_code = '' -%}
    {%- assign active_coupon_discount = '' -%}
    {%- if item_count >= 3 -%}
      {%- assign active_coupon_code = 'BUY3G10' -%}
      {%- assign active_coupon_discount = '10% OFF' -%}
    {%- elsif item_count == 2 -%}
      {%- assign active_coupon_code = 'EXTRA5' -%}
      {%- assign active_coupon_discount = '5% OFF' -%}
    {%- elsif item_count == 1 -%}
      {%- assign active_coupon_code = 'FIRST200' -%}
      {%- assign active_coupon_discount = '₹200 OFF' -%}
    {%- endif -%}

    <div
      class="cart-progress-bar__coupon-card{% if item_count >= 1 %} is-visible{% endif %}"
      {% if item_count < 1 %}style="display: none;"{% endif %}
    >
      <div class="cart-progress-bar__coupon-left">
        <span class="cart-progress-bar__coupon-tag-icon" aria-hidden="true">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#15803D" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
        </span>
        <div class="cart-progress-bar__coupon-text-wrap">
          <span class="cart-progress-bar__coupon-unlocked-title">
            Coupon unlocked: <strong class="cart-progress-bar__coupon-code-text">{{ active_coupon_code }}</strong>
          </span>
          <span class="cart-progress-bar__coupon-unlocked-sub">
            <span class="cart-progress-bar__coupon-discount-text">{{ active_coupon_discount }}</span> UNLOCKED
          </span>
        </div>
      </div>

      <div class="cart-progress-bar__coupon-right">
        <div class="cart-progress-bar__coupon-pill">
          <span class="cart-progress-bar__coupon-pill-code">{{ active_coupon_code }}</span>
        </div>
        <button
          type="button"
          class="cart-progress-bar__copy-btn"
          data-code="{{ active_coupon_code }}"
          title="Copy coupon code"
          aria-label="Copy coupon code"
        >
          {% comment %} <svg class="cart-progress-bar__copy-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg> {% endcomment %}
          <span class="cart-progress-bar__copy-text" style="color: white !important; padding: 5px;">COPY</span>
        </button>
      </div>
    </div>
  </div>
</cart-progress-bar>

