<script>
  if (!customElements.get('cart-progress-bar')) {
    class CartProgressBar extends HTMLElement {
      connectedCallback() {
        this.#bindEvents();
        // Sync with current data-cart-item-count on mount
        const initialCount = parseInt(this.dataset.cartItemCount, 10);
        if (!isNaN(initialCount)) {
          this.updateState(initialCount);
        }
      }

      #bindEvents() {
        const events = [
          'cart:update',
          'cart:updated',
          'cart-update',
          'cart:add',
          'cart-add',
          'cart:change',
          'dialog:open',
          'cart-drawer:open'
        ];
        events.forEach(evt => document.addEventListener(evt, this.#handleUpdate));

        // Copy coupon code event delegation
        this.addEventListener('click', (e) => {
          const btn = e.target.closest('.cart-progress-bar__copy-btn');
          if (!btn) return;
          e.preventDefault();
          e.stopPropagation();

          const code = btn.dataset.code || this.querySelector('.cart-progress-bar__coupon-pill-code')?.textContent?.trim();
          if (!code) return;

          const onSuccess = () => {
            btn.classList.add('is-copied');
            const textEl = btn.querySelector('.cart-progress-bar__copy-text');
            const orig = textEl ? textEl.textContent : 'COPY';
            if (textEl) textEl.textContent = 'COPIED';
            setTimeout(() => {
              btn.classList.remove('is-copied');
              if (textEl) textEl.textContent = orig;
            }, 2000);
          };

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(onSuccess).catch(() => {
              this.#fallbackCopy(code, onSuccess);
            });
          } else {
            this.#fallbackCopy(code, onSuccess);
          }
        });
      }

      #fallbackCopy(text, callback) {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try {
          document.execCommand('copy');
          if (callback) callback();
        } catch (e) {
          console.warn('Copy failed', e);
        }
        document.body.removeChild(textarea);
      }

      #handleUpdate = (event) => {
        const cartData = event?.detail?.data || event?.detail?.cart || event?.detail?.resource;
        if (cartData && typeof cartData.item_count === 'number') {
          this.updateState(cartData.item_count);
        } else if (cartData && typeof cartData.itemCount === 'number') {
          this.updateState(cartData.itemCount);
        } else {
          fetch('/cart.js')
            .then(res => res.json())
            .then(cart => {
              if (typeof cart?.item_count === 'number') {
                this.updateState(cart.item_count);
              }
            })
            .catch(() => {});
        }
      };

      updateState(itemCount) {
        const count = typeof itemCount === 'number' ? itemCount : (parseInt(this.dataset.cartItemCount, 10) || 0);
        this.dataset.cartItemCount = count;

        const tier1Unlocked = count >= 1;
        const tier2Unlocked = count >= 2;
        const tier3Unlocked = count >= 3;

        // Progress line %
        let progressPct = 0;
        if (count === 1) {
          progressPct = 25;
        } else if (count === 2) {
          progressPct = 50;
        } else if (count >= 3) {
          progressPct = 100;
        }
        this.style.setProperty('--cpb-progress-width', `${progressPct}%`);

        // Milestone classes & direct SVG white icon enforcement
        const updateMilestone = (selector, isUnlocked, isActive) => {
          const m = this.querySelector(selector);
          if (!m) return;
          m.classList.toggle('is-unlocked', isUnlocked);
          m.classList.toggle('is-active', isActive);

          const circle = m.querySelector('.cart-progress-bar__circle');
          if (circle) {
            circle.style.setProperty('color', isUnlocked ? '#FFFFFF' : '#8898AA', 'important');
            circle.style.setProperty('background-color', isUnlocked ? '#0B1F33' : '#FFFFFF', 'important');
            circle.style.setProperty('border-color', isUnlocked ? '#0B1F33' : '#CBD5E1', 'important');
            const svg = circle.querySelector('svg');
            if (svg) {
              svg.setAttribute('stroke', isUnlocked ? '#FFFFFF' : '#8898AA');
              svg.style.setProperty('color', isUnlocked ? '#FFFFFF' : '#8898AA', 'important');
              svg.style.setProperty('stroke', isUnlocked ? '#FFFFFF' : '#8898AA', 'important');
              svg.style.setProperty('fill', 'none', 'important');
              svg.querySelectorAll('path, rect, polygon, circle, line, polyline').forEach(child => {
                child.setAttribute('stroke', isUnlocked ? '#FFFFFF' : '#8898AA');
                child.style.setProperty('color', isUnlocked ? '#FFFFFF' : '#8898AA', 'important');
                child.style.setProperty('stroke', isUnlocked ? '#FFFFFF' : '#8898AA', 'important');
                child.style.setProperty('fill', 'none', 'important');
              });
            }
          }
        };

        // Milestone 1 is active when count === 1; Milestone 2 is active when count === 2; Milestone 3 is active when count >= 3
        updateMilestone('.milestone-1', tier1Unlocked, count === 1);
        updateMilestone('.milestone-2', tier2Unlocked, count === 2);
        updateMilestone('.milestone-3', tier3Unlocked, count >= 3);

        // Dynamic messaging
        let msg = '';
        if (count === 0) {
          msg = this.dataset.msgEmpty || 'ADD 1 PRODUCT TO UNLOCK ₹200 OFF';
        } else if (count === 1) {
          msg = this.dataset.msgTier1 || 'BUY 1 MORE PRODUCT TO UNLOCK 5% OFF';
        } else if (count === 2) {
          msg = this.dataset.msgTier2 || 'BUY 1 MORE PRODUCT TO UNLOCK 10% OFF';
        } else {
          msg = this.dataset.msgCompleted || '10% OFF UNLOCKED — CODE: BUY3G10';
        }

        const msgEl = this.querySelector('.cart-progress-bar__message');
        if (msgEl) {
          msgEl.textContent = msg;
        }

        // Dynamic Coupon Card update
        const couponCard = this.querySelector('.cart-progress-bar__coupon-card');
        if (couponCard) {
          if (count >= 1) {
            couponCard.style.display = 'flex';
            couponCard.classList.add('is-visible');
            let code = 'BUY3G10';
            let discount = '10% OFF';
            if (count === 1) {
              code = 'FIRST200';
              discount = '₹200 OFF';
            } else if (count === 2) {
              code = 'EXTRA5';
              discount = '5% OFF';
            }

            const codeText = couponCard.querySelector('.cart-progress-bar__coupon-code-text');
            if (codeText) codeText.textContent = code;

            const discountText = couponCard.querySelector('.cart-progress-bar__coupon-discount-text');
            if (discountText) discountText.textContent = discount;

            const pillCode = couponCard.querySelector('.cart-progress-bar__coupon-pill-code');
            if (pillCode) pillCode.textContent = code;

            const copyBtn = couponCard.querySelector('.cart-progress-bar__copy-btn');
            if (copyBtn) copyBtn.dataset.code = code;
          } else {
            couponCard.style.display = 'none';
            couponCard.classList.remove('is-visible');
          }
        }
      }
    }
    customElements.define('cart-progress-bar', CartProgressBar);
  }
</script>
