{% comment %}
  PDP Sales Demand Banner Block
  Displays recent sales velocity with flame icon and pill shape card matching user design.
  Sales and hours counts randomize on every refresh for realistic dynamic urgency.
{% endcomment %}

{% liquid
  assign target_product = product | default: closest.product
  assign product_id = target_product.id | default: section.id | default: 'main'
  assign sales_count = block.settings.sales_count | default: 188
  assign hours_count = block.settings.hours_count | default: 3
  assign subtext = block.settings.subtext | default: 'High demand – Selling fast'
%}

<div class="pdp-sales-banner" {{ block.shopify_attributes }}>
  <div class="pdp-sales-banner__card">
    <div class="pdp-sales-banner__content">
      <span class="pdp-sales-banner__icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2C10.5 4.5 9 7.5 10 10.5C8.5 9 7.5 7 7.5 5C5 7.5 4 11 4 14C4 18.4183 7.58172 22 12 22C16.4183 22 20 18.4183 20 14C20 9 16 5 12 2Z" fill="url(#pdp_flame_grad)"/>
          <path d="M12 20C14.2091 20 16 18.2091 16 16C16 13.5 14 11.5 12 10C10.5 11.5 10 13 10 14.5C10 15 9.8 15.5 9.5 16C8.8 17.2 9.5 20 12 20Z" fill="#FBBF24"/>
          <defs>
            <linearGradient id="pdp_flame_grad" x1="12" y1="2" x2="12" y2="22" gradientUnits="userSpaceOnUse">
              <stop stop-color="#F97316"/>
              <stop offset="1" stop-color="#DC2626"/>
            </linearGradient>
          </defs>
        </svg>
      </span>
      <span class="pdp-sales-banner__text">
        <strong class="pdp-sales-banner__highlight">
          <span id="PdpSalesCount-{{ product_id }}">{{ sales_count }}</span> sales in the last <span id="PdpSalesHours-{{ product_id }}">{{ hours_count }}</span> hours
        </strong>
        <span class="pdp-sales-banner__subtext"> – {{ subtext }}</span>
      </span>
    </div>
    <span class="pdp-sales-banner__arrow" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </span>
  </div>
</div>

{% style %}
  .pdp-sales-banner {
    width: 100%;
    margin-top: 6px;
    margin-bottom: 6px;
  }

  .pdp-sales-banner__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background-color: #FFF8F0;
    border: 1px solid #FFE4CB;
    border-radius: 50px;
    gap: 10px;
  }

  .pdp-sales-banner__content {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }

  .pdp-sales-banner__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pdp-sales-banner__text {
    font-family: var(--font-body--family, sans-serif);
    font-size: 13px;
    color: #4A4A4A;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pdp-sales-banner__highlight {
    font-weight: 700;
    color: #DD6B20;
  }

  .pdp-sales-banner__subtext {
    color: #666666;
    font-weight: 400;
  }

  .pdp-sales-banner__arrow {
    display: flex;
    align-items: center;
    color: #A0AEC0;
    flex-shrink: 0;
  }

  @media screen and (max-width: 600px) {
    .pdp-sales-banner__card {
      padding: 8px 12px;
    }
    .pdp-sales-banner__text {
      font-size: 11.5px;
      white-space: normal;
    }
  }
{% endstyle %}

<script>
  (function() {
    var salesEl = document.getElementById('PdpSalesCount-{{ product_id }}');
    var hoursEl = document.getElementById('PdpSalesHours-{{ product_id }}');
    
    if (salesEl) {
      // Pick random sales velocity count between 142 and 264 on each refresh
      var randomSales = Math.floor(Math.random() * (264 - 142 + 1)) + 142;
      salesEl.textContent = randomSales;
    }
    
    if (hoursEl) {
      // Pick random hours interval (2, 3, or 4 hours) on each refresh
      var randomHours = Math.floor(Math.random() * (4 - 2 + 1)) + 2;
      hoursEl.textContent = randomHours;
    }
  })();
</script>
