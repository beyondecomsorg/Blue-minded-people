{% comment %}
  PDP Trust Features Row Block
  Displays Free Shipping, Easy Returns, and Secure Checkout seamlessly blended with the product page background.
{% endcomment %}

<div class="pdp-trust-features">
  <div class="pdp-trust-features__card">
    <div class="pdp-trust-features__item">
      <div class="pdp-trust-features__icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13" rx="1"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
      <div class="pdp-trust-features__text">
        <span class="pdp-trust-features__heading">Free Shipping</span>
        <span class="pdp-trust-features__subheading">No Extra Costs</span>
      </div>
    </div>

    <div class="pdp-trust-features__item">
      <div class="pdp-trust-features__icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"></path>
          <path d="M16 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path>
          <path d="M4 7V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2"></path>
        </svg>
      </div>
      <div class="pdp-trust-features__text">
        <span class="pdp-trust-features__heading">Easy Returns</span>
        <span class="pdp-trust-features__subheading">Return with Ease</span>
      </div>
    </div>

    <div class="pdp-trust-features__item">
      <div class="pdp-trust-features__icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <polyline points="9 12 11 14 15 10"></polyline>
        </svg>
      </div>
      <div class="pdp-trust-features__text">
        <span class="pdp-trust-features__heading">Secure Checkout</span>
        <span class="pdp-trust-features__subheading">Secure Payment</span>
      </div>
    </div>
  </div>
</div>

{% style %}
  .pdp-trust-features {
    width: 100%;
    margin-top: 14px;
    margin-bottom: 8px;
  }

  .pdp-trust-features__card {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 14px 12px;
    background-color: var(--color-background, #F8F6F2);
    border-radius: 12px;
    border: 1px solid var(--color-border-grey, rgba(0, 0, 0, 0.08));
  }

  .pdp-trust-features__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .pdp-trust-features__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-deep-navy, #0B1F33);
    margin-bottom: 6px;
  }

  .pdp-trust-features__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
  }

  .pdp-trust-features__heading {
    font-family: var(--font-body--family, sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-deep-navy, #0B1F33);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .pdp-trust-features__subheading {
    font-family: var(--font-body--family, sans-serif);
    font-size: 11px;
    font-weight: 400;
    color: var(--color-medium-grey, #666666);
    line-height: 1.3;
  }

  @media screen and (max-width: 600px) {
    .pdp-trust-features__card {
      padding: 12px 8px;
      gap: 6px;
    }
    .pdp-trust-features__heading {
      font-size: 11.5px;
    }
    .pdp-trust-features__subheading {
      font-size: 10px;
    }
    .pdp-trust-features__icon svg {
      width: 20px;
      height: 20px;
    }
  }
{% endstyle %}
