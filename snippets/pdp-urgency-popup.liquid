{% comment %}
  Product Page Urgency Pop-up Component
  Displays a compact, brand-aligned urgency notification based on genuine stock or active promotions.
  Controlled via sessionStorage to avoid repeated displays in the same browsing session.
{% endcomment %}

{% liquid
  assign enable_urgency = true
  if section.settings.enable_urgency_popup == false
    assign enable_urgency = false
  endif

  assign target_product = product | default: closest.product

  assign current_variant = target_product.selected_or_first_available_variant
  assign inventory_qty = current_variant.inventory_quantity
  assign inventory_management = current_variant.inventory_management
  assign low_stock_threshold = section.settings.urgency_low_stock_threshold | default: 10
  
  assign is_low_stock = false
  if inventory_management != blank and inventory_qty != blank and inventory_qty > 0 and inventory_qty <= low_stock_threshold
    assign is_low_stock = true
  endif

  assign is_on_sale = false
  assign discount_percent = 0
  if current_variant.compare_at_price > current_variant.price
    assign is_on_sale = true
    assign raw_discount = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price
    assign discount_percent = raw_discount | round
  endif

  assign has_genuine_urgency = false
  if is_low_stock or is_on_sale
    assign has_genuine_urgency = true
  endif
%}

{% if enable_urgency and target_product != blank %}
  <pdp-urgency-toast
    class="pdp-urgency-toast"
    id="PdpUrgencyToast-{{ section.id }}"
    data-product-id="{{ target_product.id }}"
    data-low-threshold="{{ low_stock_threshold }}"
    role="region"
    aria-label="Product Availability Notice"
    style="display: none;"
  >
    <div class="pdp-urgency-toast__card color-{{ settings.popover_color_scheme }}">
      <div class="pdp-urgency-toast__icon-badge">
        <svg class="pdp-urgency-toast__icon pdp-urgency-toast__icon--fire" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="{% if is_low_stock %}{% else %}display:none;{% endif %}">
          <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
        </svg>
        <svg class="pdp-urgency-toast__icon pdp-urgency-toast__icon--tag" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="{% if is_on_sale and is_low_stock == false %}{% else %}display:none;{% endif %}">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
          <line x1="7" y1="7" x2="7.01" y2="7"></line>
        </svg>
      </div>

      <div class="pdp-urgency-toast__content">
        <div class="pdp-urgency-toast__title">
          {% if is_low_stock %}
            Only {{ inventory_qty }} Left in Stock!
          {% elsif is_on_sale %}
            Limited Time Offer
          {% endif %}
        </div>
        <div class="pdp-urgency-toast__subtitle">
          {% if is_low_stock %}
            Hurry! Items are selling fast.
          {% elsif is_on_sale %}
            Save {{ discount_percent }}% off today on this item.
          {% endif %}
        </div>
      </div>

      <button
        type="button"
        class="pdp-urgency-toast__close"
        aria-label="Close notification"
        title="Close"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <script type="application/json" class="pdp-urgency-variants-json">
      [
        {% for variant in target_product.variants %}
          {
            "id": {{ variant.id }},
            "inventory_quantity": {{ variant.inventory_quantity | default: 0 }},
            "inventory_management": {{ variant.inventory_management | json }},
            "compare_at_price": {{ variant.compare_at_price | default: 0 }},
            "price": {{ variant.price | default: 0 }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>
  </pdp-urgency-toast>

  {% style %}
    .pdp-urgency-toast {
      position: fixed;
      bottom: 24px;
      left: 24px;
      z-index: 90;
      max-width: 360px;
      width: calc(100vw - 48px);
      pointer-events: none;
    }

    .pdp-urgency-toast__card {
      pointer-events: auto;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      background-color: var(--color-background, #ffffff);
      color: var(--color-foreground, #0B1F33);
      border: 1px solid var(--color-border, rgba(11, 31, 51, 0.12));
      border-radius: var(--style-border-radius-buttons-primary, 8px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12), 0 2px 6px rgba(0, 0, 0, 0.04);
      backdrop-filter: blur(10px);
      transform: translateY(20px);
      opacity: 0;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    }

    .pdp-urgency-toast.pdp-urgency-toast--visible .pdp-urgency-toast__card {
      transform: translateY(0);
      opacity: 1;
    }

    .pdp-urgency-toast.pdp-urgency-toast--hiding .pdp-urgency-toast__card {
      transform: translateY(20px);
      opacity: 0;
    }

    .pdp-urgency-toast__icon-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background-color: rgb(var(--color-foreground-rgb, 11, 31, 51) / 0.06);
      color: var(--color-deep-navy, #0B1F33);
      flex-shrink: 0;
    }

    .pdp-urgency-toast__icon--fire {
      color: #E53E3E;
    }

    .pdp-urgency-toast__icon--tag {
      color: var(--color-deep-navy, #0B1F33);
    }

    .pdp-urgency-toast__content {
      flex: 1;
      min-width: 0;
    }

    .pdp-urgency-toast__title {
      font-family: var(--font-heading--family, sans-serif);
      font-size: 13px;
      font-weight: 600;
      color: var(--color-deep-navy, #0B1F33);
      line-height: 1.2;
      margin-bottom: 2px;
      letter-spacing: -0.01em;
    }

    .pdp-urgency-toast__subtitle {
      font-family: var(--font-body--family, sans-serif);
      font-size: 12px;
      color: var(--color-medium-grey, #666666);
      line-height: 1.3;
    }

    .pdp-urgency-toast__close {
      background: none;
      border: none;
      padding: 6px;
      cursor: pointer;
      color: var(--color-medium-grey, #888888);
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      transition: color 0.2s ease, background-color 0.2s ease;
      flex-shrink: 0;
    }

    .pdp-urgency-toast__close:hover {
      color: var(--color-deep-navy, #0B1F33);
      background-color: rgba(0, 0, 0, 0.05);
    }

    .pdp-urgency-toast__close:focus-visible {
      outline: 2px solid var(--color-deep-navy, #0B1F33);
      outline-offset: 1px;
    }

    @media screen and (max-width: 749px) {
      .pdp-urgency-toast {
        left: 16px;
        right: 16px;
        bottom: 80px;
        width: auto;
        max-width: none;
      }
    }
  {% endstyle %}

  <script>
    if (!customElements.get('pdp-urgency-toast')) {
      customElements.define('pdp-urgency-toast', class PdpUrgencyToast extends HTMLElement {
        connectedCallback() {
          this.productId = this.dataset.productId;
          if (!this.productId) return;

          this.lowThreshold = parseInt(this.dataset.lowThreshold, 10) || 10;
          this.storageKey = 'pdp_urgency_dismissed_' + this.productId;
          
          if (sessionStorage.getItem(this.storageKey) === 'true') {
            return;
          }

          this.titleEl = this.querySelector('.pdp-urgency-toast__title');
          this.subtitleEl = this.querySelector('.pdp-urgency-toast__subtitle');
          this.fireIcon = this.querySelector('.pdp-urgency-toast__icon--fire');
          this.tagIcon = this.querySelector('.pdp-urgency-toast__icon--tag');
          
          this.closeBtn = this.querySelector('.pdp-urgency-toast__close');
          if (this.closeBtn) {
            this.closeBtn.addEventListener('click', () => this.dismiss());
          }

          // Read variants JSON
          const jsonEl = this.querySelector('.pdp-urgency-variants-json');
          if (jsonEl) {
            try { this.variants = JSON.parse(jsonEl.textContent); } catch(e) { this.variants = []; }
          }

          // Initial evaluation
          this.evaluateCurrentVariant();

          // Listen for variant change events
          window.addEventListener('variant:change', (e) => this.onVariantChange(e));
          document.addEventListener('change', (e) => {
            if (e.target && e.target.name && e.target.name.startsWith('options[')) {
              setTimeout(() => this.evaluateFromForm(), 100);
            }
          });
        }

        evaluateCurrentVariant(variantData) {
          let variant = variantData;
          if (!variant && this.variants && this.variants.length > 0) {
            variant = this.variants[0];
          }

          const qty = parseInt(variant.inventory_quantity, 10) || 0;
          const isLow = qty > 0 && qty <= this.lowThreshold;
          
          const compareAt = variant.compare_at_price || 0;
          const price = variant.price || 0;
          const isSale = compareAt > price;
          const discountPct = isSale ? Math.round(((compareAt - price) * 100) / compareAt) : 0;

          if (isLow) {
            if (this.titleEl) this.titleEl.textContent = `Only ${qty} Left in Stock!`;
            if (this.subtitleEl) this.subtitleEl.textContent = 'Hurry! Items are selling fast.';
            if (this.fireIcon) this.fireIcon.style.display = 'block';
            if (this.tagIcon) this.tagIcon.style.display = 'none';
            this.scheduleShow();
          } else if (isSale) {
            if (this.titleEl) this.titleEl.textContent = 'Limited Time Offer';
            if (this.subtitleEl) this.subtitleEl.textContent = `Save ${discountPct}% off today on this item.`;
            if (this.fireIcon) this.fireIcon.style.display = 'none';
            if (this.tagIcon) this.tagIcon.style.display = 'block';
            this.scheduleShow();
          } else {
            // No genuine urgency condition for this variant
            if (this.classList.contains('pdp-urgency-toast--visible')) {
              this.hide();
            }
          }
        }

        scheduleShow() {
          if (sessionStorage.getItem(this.storageKey) === 'true') return;
          if (this.timer) clearTimeout(this.timer);
          this.timer = setTimeout(() => this.show(), 1200);
        }

        onVariantChange(event) {
          if (event && event.detail && event.detail.variant) {
            this.evaluateCurrentVariant(event.detail.variant);
          }
        }

        evaluateFromForm() {
          const urlParams = new URLSearchParams(window.location.search);
          const variantId = urlParams.get('variant');
          if (variantId && this.variants) {
            const found = this.variants.find(v => String(v.id) === String(variantId));
            if (found) this.evaluateCurrentVariant(found);
          }
        }

        show() {
          this.style.display = 'block';
          void this.offsetWidth;
          this.classList.add('pdp-urgency-toast--visible');
          this.classList.remove('pdp-urgency-toast--hiding');
        }

        hide() {
          this.classList.remove('pdp-urgency-toast--visible');
          this.classList.add('pdp-urgency-toast--hiding');
          setTimeout(() => {
            this.style.display = 'none';
          }, 400);
        }

        dismiss() {
          this.hide();
          sessionStorage.setItem(this.storageKey, 'true');
        }
      });
    }
  </script>
{% endif %}
