

<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

{% capture media_gallery %}
  {%- content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: closest.product
  -%}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: closest.product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if section.settings.enable_sticky_add_to_cart %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    # Get the initial quantity based on quantity rules
    assign initial_quantity = current_variant.quantity_rule.min | default: 1
  %}

  <sticky-add-to-cart
    class="sticky-add-to-cart"
    data-variant-available="{{ current_variant.available }}"
    data-product-id="{{ product.id }}"
    data-current-variant-id="{{ current_variant.id }}"
    data-initial-quantity="{{ initial_quantity }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="sticky-add-to-cart__bar color-{{ settings.popover_color_scheme }}"
      data-stuck="false"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      {% liquid
        assign image_to_show = current_variant.featured_image | default: product.featured_image
      %}
      {% if image_to_show %}
        <div
          class="sticky-add-to-cart__image"
        >
          {% assign image_alt = image_to_show.alt | default: product.title | escape %}
          {{
            image_to_show
            | image_url: width: 120
            | image_tag:
              loading: 'lazy',
              alt: image_alt,
              class: 'sticky-add-to-cart__image-img',
              data-testid: 'sticky-product-image',
              srcset: null,
              sizes: null,
              ref: 'productImage'
          }}
        </div>
      {% endif %}

      {% liquid
        assign has_single_option = false
        if product.has_only_default_variant != true and product.options.size == 1
          assign has_single_option = true
        endif

        if image_to_show == blank
          assign has_image = false
        else
          assign has_image = true
        endif
      %}
      <div
        class="sticky-add-to-cart__info"
        data-has-image="{{ has_image }}"
        data-singleton="{{ product.has_only_default_variant }}"
        data-single-option="{{ has_single_option }}"
        onclick="document.querySelector('.product-form-buttons, variant-picker, .product-media')?.scrollIntoView({ behavior: 'smooth', block: 'center' });"
        role="button"
        tabindex="0"
        title="View product options"
      >
        <p
          class="sticky-add-to-cart__title"
          data-testid="sticky-product-title"
        >
          {{ product.title | escape }}
        </p>

        <div class="sticky-add-to-cart__meta-row">
          <div
            class="sticky-add-to-cart__price"
            data-testid="sticky-price-display"
          >
            {% render 'price', product_resource: product, show_sale_price_first: true %}
          </div>
          {% unless product.has_only_default_variant %}
            <span class="sticky-add-to-cart__meta-divider" aria-hidden="true">•</span>
            <div
              class="sticky-add-to-cart__variant"
              data-testid="sticky-variant-title"
            >
              {% if current_variant != blank %}
                {% assign variant_title = current_variant.title | escape %}
              {% endif %}
              {{ variant_title }}
            </div>
          {% endunless %}
        </div>
      </div>

      <div class="sticky-add-to-cart__actions">
        <button
          type="button"
          class="sticky-add-to-cart__button add-to-cart-button button button--secondary"
          ref="addToCartButton"
          on:click="/handleAddToCartClick"
          {% unless current_variant.available %}
            disabled
          {% endunless %}
          aria-label="{{ 'products.product.add_to_cart' | t }}"
        >
          <span
            class="add-to-cart-text"
          >
            {% if current_variant.available %}
              <span class="svg-wrapper add-to-cart-icon">
                {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
              </span>
            {% endif %}
            <span class="add-to-cart-text__content">
              <span class="sticky-btn-text-full">
                {%- if current_variant.available -%}
                  {{- 'products.product.add_to_cart' | t -}}
                {%- elsif current_variant == blank -%}
                  {{- 'products.product.unavailable' | t -}}
                {%- else -%}
                  {{- 'products.product.sold_out' | t -}}
                {%- endif -%}
              </span>
              <span class="sticky-btn-text-short">
                {%- if current_variant.available -%}
                  Add to Cart
                {%- elsif current_variant == blank -%}
                  Unavailable
                {%- else -%}
                  Sold Out
                {%- endif -%}
              </span>
              <span
                ref="quantityDisplay"
                {% if current_variant.available and initial_quantity > 1 %}
                  style="display: inline;"
                {% else %}
                  style="display: none;"
                {% endif %}
              >
                {{- ' (' -}}
                <span ref="quantityNumber">{{- initial_quantity -}}</span>
                {{- ')' -}}
              </span>
            </span>
          </span>
          <span class="add-to-cart__added">
            <span class="svg-wrapper add-to-cart__added-icon">
              {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
            </span>
          </span>
        </button>

        <button
          type="button"
          class="sticky-add-to-cart__buy-now button"
          ref="buyNowButton"
          on:click="/handleBuyNowClick"
          {% unless current_variant.available %}
            disabled
          {% endunless %}
          aria-label="Buy Now"
        >
          <span class="sticky-buy-now-text">
            <span class="sticky-buy-now-full">
              {%- if current_variant.available -%}
                Buy It Now
              {%- else -%}
                {{- 'products.product.sold_out' | t -}}
              {%- endif -%}
            </span>
            <span class="sticky-buy-now-short">
              {%- if current_variant.available -%}
                Buy Now
              {%- else -%}
                Sold Out
              {%- endif -%}
            </span>
          </span>
        </button>
      </div>
    </div>
  </sticky-add-to-cart>
{% endif %}

{% render 'product-information-content',
  product_media_size: closest.product.media.size,
  section_id: section.id,
  settings: section.settings,
  media_gallery: media_gallery,
  product_details: product_details,
  additional_blocks: additional_blocks
%}

{% render 'pdp-info-enhancements' %}
{% assign urgency_product = closest.product | default: product %}
{% render 'pdp-urgency-popup', product: urgency_product, section: section %}

{% stylesheet %}
  .sticky-add-to-cart__bar {
    position: fixed;
    bottom: 20px;
    left: 50%;
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    z-index: calc(var(--layer-sticky) - 1); /* Below sticky header */
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(650px, calc(100vw - 32px));
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px) saturate(180%);
    box-shadow: 0 10px 25px -5px rgba(11, 31, 51, 0.12), 0 8px 10px -6px rgba(11, 31, 51, 0.06);
    border: 1px solid rgba(226, 232, 240, 0.9);
    padding: 10px 16px;
    box-sizing: border-box;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticky-add-to-cart__bar {
      transition-property: transform, opacity, display;
      transition-duration: 0.3s;
      transition-timing-function: var(--ease-out-quad);
      transition-behavior: allow-discrete;
    }
  }

  .sticky-add-to-cart__bar[data-stuck='true'] {
    transform: translateX(-50%) translateY(0%);
    opacity: 1;
  }

  sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__bar {
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    display: none;
  }

  .sticky-add-to-cart__image {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    min-width: 46px;
    min-height: 46px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #E2E8F0;
    background: #F8FAFC;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .sticky-add-to-cart__image:hover {
    transform: scale(1.04);
  }

  .sticky-add-to-cart__image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sticky-add-to-cart__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    cursor: pointer;
  }

  .sticky-add-to-cart__title {
    font-size: 13.5px;
    font-weight: 600;
    color: #0B1F33;
    line-height: 1.25;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sticky-add-to-cart__meta-row {
    display: flex;
    align-items: center;
    gap: 6px;
    line-height: 1.2;
    overflow: hidden;
  }

  .sticky-add-to-cart__price {
    font-size: 13px;
    font-weight: 700;
    color: #0B1F33;
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    margin: 0;
    padding: 0;
  }

  .sticky-add-to-cart__price .price {
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }

  .sticky-add-to-cart__price .compare-at-price {
    font-size: 11px;
    color: #94A3B8;
    text-decoration: line-through;
    font-weight: 400;
  }

  .sticky-add-to-cart__meta-divider {
    color: #CBD5E1;
    font-size: 10px;
    flex-shrink: 0;
  }

  .sticky-add-to-cart__variant {
    font-size: 11.5px;
    font-weight: 500;
    color: #475569;
    background: #F1F5F9;
    padding: 1px 6px;
    border-radius: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 140px;
    line-height: 1.3;
  }

  .sticky-add-to-cart__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .sticky-add-to-cart__button,
  .sticky-add-to-cart__buy-now {
    height: 42px;
    border-radius: 6px;
    font-size: 12.5px;
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }

  .sticky-add-to-cart__button {
    background: #FFFFFF;
    border: 1.5px solid #0B1F33;
    color: #0B1F33;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .sticky-add-to-cart__button:hover {
    background: #F8FAFC;
    border-color: #1A365D;
    color: #1A365D;
  }

  .sticky-add-to-cart__button .add-to-cart-icon {
    width: 14px;
    height: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .sticky-add-to-cart__button .add-to-cart-icon svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
  }

  .sticky-add-to-cart__buy-now {
    background-color: #0B1F33;
    border: 1.5px solid #0B1F33;
    color: #FFFFFF;
    padding: 0 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .sticky-add-to-cart__buy-now:hover {
    background-color: #1A365D;
    border-color: #1A365D;
  }

  .sticky-add-to-cart__buy-now[disabled],
  .sticky-add-to-cart__button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .sticky-btn-text-short,
  .sticky-buy-now-short {
    display: none;
  }

  /* Mobile Experience (Under 750px) */
  @media screen and (max-width: 749px) {
    .sticky-add-to-cart__bar {
      bottom: 0;
      left: 0;
      right: 0;
      width: 100%;
      max-width: 100%;
      border-radius: 0;
      transform: translateY(100%);
      padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px)) 12px;
      gap: 10px;
      border-left: none;
      border-right: none;
      border-bottom: none;
      border-top: 1px solid #E2E8F0;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
    }

    .sticky-add-to-cart__bar[data-stuck='true'] {
      transform: translateY(0);
      opacity: 1;
    }

    .sticky-add-to-cart__image {
      width: 42px;
      height: 42px;
      min-width: 42px;
      min-height: 42px;
      border-radius: 6px;
    }

    .sticky-add-to-cart__info {
      flex: 1;
      min-width: 0;
      gap: 2px;
    }

    .sticky-add-to-cart__title {
      font-size: 12px;
      line-height: 1.25;
      display: block !important;
    }

    .sticky-add-to-cart__meta-row {
      gap: 5px;
    }

    .sticky-add-to-cart__price {
      font-size: 12.5px;
    }

    .sticky-add-to-cart__price .compare-at-price {
      display: inline-block !important;
      font-size: 10px;
    }

    .sticky-add-to-cart__variant {
      font-size: 10.5px;
      max-width: 85px;
      padding: 1px 5px;
      display: inline-block !important;
    }

    .sticky-add-to-cart__actions {
      gap: 6px;
    }

    .sticky-add-to-cart__button,
    .sticky-add-to-cart__buy-now {
      height: 38px;
      font-size: 11.5px;
      border-radius: 6px;
    }

    .sticky-add-to-cart__button {
      padding: 0 10px;
      width: auto !important;
    }

    .sticky-add-to-cart__button .add-to-cart-text__content {
      display: inline-flex !important;
    }

    .sticky-add-to-cart__button .add-to-cart-icon {
      display: none;
    }

    .sticky-add-to-cart__buy-now {
      padding: 0 14px;
    }

    .sticky-btn-text-full {
      display: none;
    }

    .sticky-btn-text-short {
      display: inline;
    }

    .sticky-buy-now-full {
      display: none;
    }

    .sticky-buy-now-short {
      display: inline;
    }
  }

  /* Ultra-narrow devices (< 360px) */
  @media screen and (max-width: 359px) {
    .sticky-add-to-cart__bar {
      padding: 6px 8px calc(6px + env(safe-area-inset-bottom, 0px)) 8px;
      gap: 6px;
    }

    .sticky-add-to-cart__image {
      width: 36px;
      height: 36px;
      min-width: 36px;
      min-height: 36px;
    }

    .sticky-add-to-cart__title {
      font-size: 11px;
    }

    .sticky-add-to-cart__price {
      font-size: 11.5px;
    }

    .sticky-add-to-cart__variant {
      max-width: 65px;
      font-size: 10px;
    }

    .sticky-add-to-cart__button {
      padding: 0 7px;
      font-size: 10.5px;
    }

    .sticky-add-to-cart__buy-now {
      padding: 0 10px;
      font-size: 10.5px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "t:settings.enable_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Urgency Pop-up & Live Viewer Count"
    },
    {
      "type": "checkbox",
      "id": "enable_urgency_popup",
      "label": "Enable Urgency Pop-up",
      "default": true
    },
    {
      "type": "range",
      "id": "urgency_low_stock_threshold",
      "label": "Low Stock Threshold",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 10,
      "info": "Display low-stock urgency pop-up when inventory is at or below this number."
    },
    {
      "type": "checkbox",
      "id": "enable_live_viewer_count",
      "label": "Enable Live Viewer Count",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
