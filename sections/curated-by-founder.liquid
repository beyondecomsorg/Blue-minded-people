{{ 'https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css' | stylesheet_tag }}

{%- style -%}
  .cbf-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (max-width: 767px) {
    .cbf-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }

  .cbf-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .cbf-header {
    text-align: {{ section.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .cbf-heading {
    font-family: var(--wb-font-heading, "Helvetica Neue", Arial, sans-serif);
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 10px;
    color: {{ section.settings.text_color }};
  }

  .cbf-subheading {
    font-family: var(--wb-font-body, "Helvetica Neue", Arial, sans-serif);
    font-size: 16px;
    line-height: 1.5;
    margin: 0;
    color: {{ section.settings.text_color_sub }};
    font-weight: 300;
  }

  @media screen and (max-width: 767px) {
    .cbf-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
    .cbf-subheading {
      font-size: 14px;
    }
    .cbf-header {
      margin-bottom: 24px;
    }
  }

  /* Grid Layout */
  .cbf-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  @media screen and (max-width: 1023px) {
    .cbf-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: {{ section.settings.grid_gap_tablet }}px;
    }
  }

  @media screen and (max-width: 767px) {
    .cbf-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ section.settings.grid_gap_mobile }}px;
    }
  }

  /* Tile Styling */
  .cbf-tile {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    display: block;
    text-decoration: none;
    background-color: #f4f4f4;
    border-radius: 4px;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.3s ease, transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cbf-tile.is-active {
    border-color: var(--color-foreground, #000000);
  }

  .cbf-tile-img-wrap {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .cbf-tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cbf-tile:hover .cbf-tile-img {
    transform: scale(1.06);
  }

  .cbf-tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.3) 50%,
      rgba(0, 0, 0, 0) 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .cbf-tile-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 24px;
    box-sizing: border-box;
    z-index: 2;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .cbf-tile-num {
    font-family: var(--wb-font-body, "Helvetica Neue", Arial, sans-serif);
    font-size: 12px;
    letter-spacing: 0.1em;
    opacity: 0.7;
    margin-bottom: 6px;
    font-weight: 500;
  }

  .cbf-tile-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }

  .cbf-tile-title {
    font-family: var(--wb-font-heading, "Helvetica Neue", Arial, sans-serif);
    font-size: 20px;
    font-weight: 600;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .cbf-tile-desc {
    font-family: var(--wb-font-body, "Helvetica Neue", Arial, sans-serif);
    font-size: 12px;
    opacity: 0.8;
    margin-top: 6px;
    line-height: 1.4;
    font-weight: 300;
  }

  .cbf-tile-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .cbf-tile-arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .cbf-tile:hover .cbf-tile-arrow {
    transform: translateX(4px);
  }

  @media screen and (max-width: 767px) {
    .cbf-tile-content {
      padding: 16px;
    }
    .cbf-tile-title {
      font-size: 16px;
    }
    .cbf-tile-desc {
      display: none; /* Keep mobile clean */
    }
  }

  /* Interactive Flow Panel inside the Tile */
  .cbf-flow-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(18, 18, 18, 0.98);
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .cbf-tile.flow-active .cbf-flow-overlay {
    opacity: 1;
    visibility: visible;
  }

  .cbf-flow-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cbf-flow-heading {
    font-family: var(--wb-font-heading, "Helvetica Neue", Arial, sans-serif);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .cbf-flow-close {
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .cbf-flow-close:hover {
    opacity: 1;
  }

  .cbf-flow-close svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  .cbf-flow-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 16px;
    justify-content: center;
    overflow-y: auto;
  }

  .cbf-step {
    display: none;
  }

  .cbf-step.step-active {
    display: block;
    animation: cbf-fade-in 0.3s ease forwards;
  }

  @keyframes cbf-fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cbf-step-title {
    font-family: var(--wb-font-heading, "Helvetica Neue", Arial, sans-serif);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
  }

  .cbf-options-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cbf-option-btn {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    padding: 8px 16px;
    font-size: 13px;
    text-transform: uppercase;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 2px;
    font-family: var(--wb-font-body, "Helvetica Neue", Arial, sans-serif);
  }

  .cbf-option-btn:hover {
    border-color: #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
  }

  .cbf-option-btn.selected {
    background-color: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }

  .cbf-flow-footer {
    padding: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .cbf-back-btn {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: color 0.2s ease;
    padding: 6px 0;
    font-family: var(--wb-font-body, "Helvetica Neue", Arial, sans-serif);
  }

  .cbf-back-btn:hover {
    color: #ffffff;
  }

  .cbf-submit-btn {
    flex: 1;
    background-color: #ffffff;
    color: #000000;
    border: none;
    padding: 10px 16px;
    font-size: 13px;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: opacity 0.2s ease;
    text-align: center;
    text-decoration: none;
    border-radius: 2px;
    font-family: var(--wb-font-body, "Helvetica Neue", Arial, sans-serif);
  }

  .cbf-submit-btn:hover {
    opacity: 0.9;
  }

  .cbf-submit-btn:disabled {
    background-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.4);
    cursor: not-allowed;
  }

  /* Products Container Styles */
  .cbf-products-container {
    margin-top: 40px;
    width: 100%;
  }

  .cbf-collection-products {
    width: 100%;
  }

  .cbf-products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .cbf-product-grid-item {
    width: 100%;
  }

  @media screen and (max-width: 1023px) {
    .cbf-products-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  @media screen and (max-width: 767px) {
    .cbf-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

  .cbf-no-products {
    text-align: center;
    font-size: 16px;
    color: var(--color-foreground, #000000);
    opacity: 0.6;
    margin: 40px 0;
  }

  /* Splide customization for curated section */
  .cbf-products-splide {
    position: relative;
    width: 100%;
  }

  .cbf-products-splide .splide__track {
    overflow: hidden;
  }

  .cbf-product-slide {
    width: calc((100% - 48px) / 4) !important;
  }

  @media screen and (max-width: 1023px) {
    .cbf-product-slide {
      width: calc((100% - 32px) / 3) !important;
    }
  }

  @media screen and (max-width: 767px) {
    .cbf-product-slide {
      width: calc((100% - 12px) / 2) !important;
    }
  }

  .cbf-carousel-arrows {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 16px;
  }

  .cbf-carousel-arrow {
    background: var(--color-background, #ffffff);
    border: 1px solid rgb(var(--color-border-rgb) / var(--media-border-opacity, 0.15));
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    color: var(--color-foreground, #000000);
  }

  .cbf-carousel-arrow:hover {
    background: var(--color-foreground, #000000);
    color: var(--color-background, #ffffff);
  }

  .cbf-carousel-arrow svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
  }

  .cbf-carousel-arrow[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
  }
{%- endstyle -%}

<section class="cbf-section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="cbf-container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="cbf-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="cbf-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="cbf-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cbf-grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.enable -%}
          {%- liquid
            assign is_interactive = block.settings.enable_interactive_flow
            assign tile_url = block.settings.custom_url
            if tile_url == blank and block.settings.collection != blank
              assign tile_url = block.settings.collection.url
            endif
          -%}

          {%- if is_interactive -%}
            <div
              class="cbf-tile cbf-interactive"
              id="cbf-block-{{ block.id }}"
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
          {%- else -%}
            <a
              href="{{ tile_url | default: '#' }}"
              class="cbf-tile"
              id="cbf-block-{{ block.id }}"
              data-block-id="{{ block.id }}"
              data-has-custom-url="{% if block.settings.custom_url != blank %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
          {%- endif -%}
            <!-- Image -->
            <div class="cbf-tile-img-wrap">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    class: 'cbf-tile-img',
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    alt: block.settings.title
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'cbf-tile-img' }}
              {%- endif -%}
            </div>

            <!-- Overlay -->
            <div class="cbf-tile-overlay"></div>

            <!-- Content -->
            <div class="cbf-tile-content">
              {%- if block.settings.collection_number != blank -%}
                <div class="cbf-tile-num">{{ block.settings.collection_number }}</div>
              {%- endif -%}
              <div class="cbf-tile-title-row">
                <h3 class="cbf-tile-title">{{ block.settings.title | default: block.settings.collection.title }}</h3>
                <span class="cbf-tile-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
              {%- if block.settings.description != blank -%}
                <p class="cbf-tile-desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>

            <!-- Interactive Flow Overlay (For Stressed Jeans / Custom Flow) -->
            {%- if is_interactive -%}
              {%- liquid
                assign fits = block.settings.fit_options | split: ','
                assign sizes = block.settings.size_options | split: ','
                assign colors = block.settings.color_options | split: ','
              -%}
              <div class="cbf-flow-overlay">
                <div class="cbf-flow-header">
                  <span class="cbf-flow-heading">{{ block.settings.title }}</span>
                  <button class="cbf-flow-close" type="button" aria-label="Close panel">
                    <svg viewBox="0 0 24 24">
                      <path d="M18 6L6 18M6 6l12 12"/>
                    </svg>
                  </button>
                </div>

                <div class="cbf-flow-body">
                  <!-- Step 1: Fit -->
                  <div class="cbf-step step-active" data-step="1">
                    <div class="cbf-step-title">Select Fit</div>
                    <div class="cbf-options-list">
                      {%- for fit in fits -%}
                        {%- assign clean_fit = fit | strip -%}
                        {%- if clean_fit != blank -%}
                          <button class="cbf-option-btn" type="button" data-val="{{ clean_fit }}">{{ clean_fit }}</button>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>

                  <!-- Step 2: Size -->
                  <div class="cbf-step" data-step="2">
                    <div class="cbf-step-title">Select Size</div>
                    <div class="cbf-options-list">
                      {%- for size in sizes -%}
                        {%- assign clean_size = size | strip -%}
                        {%- if clean_size != blank -%}
                          <button class="cbf-option-btn" type="button" data-val="{{ clean_size }}">{{ clean_size }}</button>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>

                  <!-- Step 3: Color -->
                  <div class="cbf-step" data-step="3">
                    <div class="cbf-step-title">Select Color</div>
                    <div class="cbf-options-list">
                      {%- for color in colors -%}
                        {%- assign clean_color = color | strip -%}
                        {%- if clean_color != blank -%}
                          <button class="cbf-option-btn" type="button" data-val="{{ clean_color }}">{{ clean_color }}</button>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                </div>

                <div class="cbf-flow-footer">
                  <button class="cbf-back-btn" type="button" style="display: none;">Back</button>
                  <button class="cbf-submit-btn" type="button" disabled data-base-url="{{ tile_url }}" data-fit-param="{{ block.settings.fit_param }}" data-size-param="{{ block.settings.size_param }}" data-color-param="{{ block.settings.color_param }}">
                    View Listing
                  </button>
                </div>
              </div>
            {%- endif -%}
          {%- if is_interactive -%}
            </div>
          {%- else -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Products Container for Curated Tiles -->
    <div class="cbf-products-container">
      {%- assign first_non_interactive_block_id = blank -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.enable and block.settings.enable_interactive_flow == false -%}
          {%- if first_non_interactive_block_id == blank -%}
            {%- assign first_non_interactive_block_id = block.id -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- for block in section.blocks -%}
        {%- if block.settings.enable -%}
          {%- liquid
            assign block_collection = block.settings.collection
            assign is_interactive = block.settings.enable_interactive_flow
            assign is_active = false
            if first_non_interactive_block_id == block.id
              assign is_active = true
            endif
          -%}
          {%- if block_collection != blank and is_interactive == false -%}
            <div
              class="cbf-collection-products {% if is_active %}is-active{% endif %}"
              id="cbf-products-{{ block.id }}"
              data-block-id="{{ block.id }}"
              style="{% unless is_active %}display: none;{% endunless %}"
            >
              {%- if block_collection.products_count > 0 -%}
                {%- if block_collection.products_count > 4 -%}
                  <!-- Render Splide Carousel -->
                  <div class="splide cbf-products-splide" id="splide-{{ block.id }}">
                    <div class="splide__track">
                      <div class="splide__list">
                        {%- for product in block_collection.products limit: 12 -%}
                          <div class="splide__slide cbf-product-slide">
                            {%- render 'product-card', product: product -%}
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                    <!-- Splide Arrows -->
                    <div class="splide__arrows cbf-carousel-arrows">
                      <button class="splide__arrow splide__arrow--prev cbf-carousel-arrow cbf-carousel-arrow--prev" aria-label="Previous">
                        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
                      </button>
                      <button class="splide__arrow splide__arrow--next cbf-carousel-arrow cbf-carousel-arrow--next" aria-label="Next">
                        <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </button>
                    </div>
                  </div>
                {%- else -%}
                  <!-- Render simple grid for 4 or fewer products -->
                  <div class="cbf-products-grid">
                    {%- for product in block_collection.products limit: 4 -%}
                      <div class="cbf-product-grid-item">
                        {%- render 'product-card', product: product -%}
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              {%- else -%}
                <p class="cbf-no-products">No products found in this collection.</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js" defer></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const interactiveTiles = document.querySelectorAll('.cbf-tile.cbf-interactive');

    interactiveTiles.forEach(function(tile) {
      const overlay = tile.querySelector('.cbf-flow-overlay');
      const closeBtn = tile.querySelector('.cbf-flow-close');
      const backBtn = tile.querySelector('.cbf-back-btn');
      const submitBtn = tile.querySelector('.cbf-submit-btn');
      const steps = tile.querySelectorAll('.cbf-step');
      
      let selections = {
        fit: '',
        size: '',
        color: ''
      };
      let currentStepIndex = 0; // 0: Fit, 1: Size, 2: Color

      function updateStepView() {
        steps.forEach((step, idx) => {
          if (idx === currentStepIndex) {
            step.classList.add('step-active');
          } else {
            step.classList.remove('step-active');
          }
        });

        // Toggle back button visibility
        if (currentStepIndex > 0) {
          backBtn.style.display = 'block';
        } else {
          backBtn.style.display = 'none';
        }

        // Enable/Disable submit button on color screen
        if (currentStepIndex === 2 && selections.color) {
          submitBtn.removeAttribute('disabled');
        } else {
          submitBtn.setAttribute('disabled', 'disabled');
        }
      }

      function resetFlow() {
        selections = { fit: '', size: '', color: '' };
        currentStepIndex = 0;
        tile.querySelectorAll('.cbf-option-btn').forEach(btn => btn.classList.remove('selected'));
        updateStepView();
      }

      // Open overlay on tile click
      tile.addEventListener('click', function(e) {
        if (!tile.classList.contains('flow-active') && !e.target.closest('.cbf-flow-overlay')) {
          e.preventDefault();
          e.stopPropagation();
          tile.classList.add('flow-active');
          resetFlow();
        }
      });

      // Close button
      closeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        tile.classList.remove('flow-active');
      });

      // Back button
      backBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        if (currentStepIndex > 0) {
          currentStepIndex--;
          updateStepView();
        }
      });

      // Option selection
      tile.querySelectorAll('.cbf-option-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();

          const parentStep = btn.closest('.cbf-step');
          const stepNum = parseInt(parentStep.getAttribute('data-step'), 10);

          // Clear selection on siblings
          parentStep.querySelectorAll('.cbf-option-btn').forEach(sibling => sibling.classList.remove('selected'));
          btn.classList.add('selected');

          const val = btn.getAttribute('data-val');

          if (stepNum === 1) {
            selections.fit = val;
            currentStepIndex = 1;
            updateStepView();
          } else if (stepNum === 2) {
            selections.size = val;
            currentStepIndex = 2;
            updateStepView();
          } else if (stepNum === 3) {
            selections.color = val;
            updateStepView();
          }
        });
      });

      // Submit Button Click
      submitBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        const baseUrl = submitBtn.getAttribute('data-base-url') || '#';
        const fitParam = submitBtn.getAttribute('data-fit-param') || 'filter.v.option.fit';
        const sizeParam = submitBtn.getAttribute('data-size-param') || 'filter.v.option.size';
        const colorParam = submitBtn.getAttribute('data-color-param') || 'filter.v.option.color';

        const url = new URL(baseUrl, window.location.origin);
        url.searchParams.set(fitParam, selections.fit);
        url.searchParams.set(sizeParam, selections.size);
        url.searchParams.set(colorParam, selections.color);

        window.location.href = url.toString();
      });
    });

    // --- Collection Products Carousel / Tab Navigation JS ---
    function initSplide(container) {
      if (typeof Splide === 'undefined') {
        setTimeout(() => initSplide(container), 100);
        return;
      }
      if (container.classList.contains('splide-initialized')) return;
      
      const splideEl = container.querySelector('.cbf-products-splide');
      if (!splideEl) return;
      
      const splide = new Splide(splideEl, {
        type: 'slide',
        perPage: 4,
        perMove: 1,
        gap: '20px',
        pagination: false,
        arrows: true,
        breakpoints: {
          1024: { perPage: 3, gap: '16px' },
          768: { perPage: 2, gap: '12px' },
          480: { perPage: 2, gap: '12px' }
        }
      });
      
      splide.mount();
      container.classList.add('splide-initialized');
    }

    const nonInteractiveTiles = document.querySelectorAll('.cbf-tile:not(.cbf-interactive)');
    nonInteractiveTiles.forEach(function(tile) {
      const hasCustomUrl = tile.getAttribute('data-has-custom-url') === 'true';
      if (!hasCustomUrl) {
        tile.addEventListener('click', function(e) {
          e.preventDefault();
          
          document.querySelectorAll('.cbf-tile').forEach(t => t.classList.remove('is-active'));
          tile.classList.add('is-active');
          
          const blockId = tile.getAttribute('data-block-id');
          document.querySelectorAll('.cbf-collection-products').forEach(container => {
            container.style.display = 'none';
            container.classList.remove('is-active');
          });
          
          const activeContainer = document.getElementById('cbf-products-' + blockId);
          if (activeContainer) {
            activeContainer.style.display = 'block';
            activeContainer.classList.add('is-active');
            initSplide(activeContainer);
          }
        });
      }
    });

    // Initialize the first active Splide carousel
    const firstActiveContainer = document.querySelector('.cbf-collection-products.is-active');
    if (firstActiveContainer) {
      const firstBlockId = firstActiveContainer.getAttribute('data-block-id');
      const firstTile = document.getElementById('cbf-block-' + firstBlockId);
      if (firstTile) firstTile.classList.add('is-active');
      
      initSplide(firstActiveContainer);
    }
  });
</script>

