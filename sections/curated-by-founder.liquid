
{%- style -%}
  .cbf-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (max-width: 767px) {
    .cbf-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }

  .cbf-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .cbf-header {
    text-align: {{ section.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .cbf-heading {
    font-family: var(--wb-font-heading, "Helvetica Neue", Arial, sans-serif);
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 10px;
    color: {{ section.settings.text_color }};
  }

  .cbf-subheading {
    font-family: var(--wb-font-body, "Helvetica Neue", Arial, sans-serif);
    font-size: 16px;
    line-height: 1.5;
    margin: 0;
    color: {{ section.settings.text_color_sub }};
    font-weight: 300;
  }

  @media screen and (max-width: 767px) {
    .cbf-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
    .cbf-subheading {
      font-size: 14px;
    }
    .cbf-header {
      margin-bottom: 24px;
    }
  }

  /* Grid Layout */
  .cbf-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  @media screen and (max-width: 1023px) {
    .cbf-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: {{ section.settings.grid_gap_tablet }}px;
    }
  }

  @media screen and (max-width: 767px) {
    .cbf-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ section.settings.grid_gap_mobile }}px;
    }
  }

  /* Tile Styling */
  .cbf-tile {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    display: block;
    text-decoration: none;
    background-color: #f4f4f4;
    border-radius: 4px;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.3s ease, transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cbf-tile.is-active {
    border-color: var(--color-foreground, #000000);
  }

  .cbf-tile-img-wrap {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .cbf-tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cbf-tile:hover .cbf-tile-img {
    transform: scale(1.06);
  }

  .cbf-tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.3) 50%,
      rgba(0, 0, 0, 0) 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .cbf-tile-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 24px;
    box-sizing: border-box;
    z-index: 2;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .cbf-tile-num {
    font-family: var(--wb-font-body, "Helvetica Neue", Arial, sans-serif);
    font-size: 12px;
    letter-spacing: 0.1em;
    opacity: 0.7;
    margin-bottom: 6px;
    font-weight: 500;
  }

  .cbf-tile-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }

  .cbf-tile-title {
    font-family: var(--wb-font-heading, "Helvetica Neue", Arial, sans-serif);
    font-size: 20px;
    font-weight: 600;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .cbf-tile-desc {
    font-family: var(--wb-font-body, "Helvetica Neue", Arial, sans-serif);
    font-size: 12px;
    opacity: 0.8;
    margin-top: 6px;
    line-height: 1.4;
    font-weight: 300;
  }

  .cbf-tile-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .cbf-tile-arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .cbf-tile:hover .cbf-tile-arrow {
    transform: translateX(4px);
  }

  @media screen and (max-width: 767px) {
    .cbf-tile-content {
      padding: 16px;
    }
    .cbf-tile-title {
      font-size: 16px;
    }
    .cbf-tile-desc {
      display: none; /* Keep mobile clean */
    }
  }

  /* Interactive Flow Panel inside the Tile */
  .cbf-flow-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(18, 18, 18, 0.98);
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .cbf-tile.flow-active .cbf-flow-overlay,
  .cbf-tile:hover .cbf-flow-overlay {
    opacity: 1;
    visibility: visible;
  }

  .cbf-flow-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cbf-flow-heading {
    font-family: var(--wb-font-heading, "Helvetica Neue", Arial, sans-serif);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .cbf-flow-close {
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .cbf-flow-close:hover {
    opacity: 1;
  }

  .cbf-flow-close svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  .cbf-flow-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 16px;
    justify-content: center;
    overflow-y: auto;
  }

  .cbf-step {
    display: none;
  }

  .cbf-step.step-active {
    display: block;
    animation: cbf-fade-in 0.3s ease forwards;
  }

  @keyframes cbf-fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cbf-step-title {
    font-family: var(--wb-font-heading, "Helvetica Neue", Arial, sans-serif);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
  }

  .cbf-options-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cbf-option-btn {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    padding: 8px 16px;
    font-size: 13px;
    text-transform: uppercase;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 2px;
    font-family: var(--wb-font-body, "Helvetica Neue", Arial, sans-serif);
  }

  .cbf-option-btn:hover {
    border-color: #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
  }

  .cbf-option-btn.selected {
    background-color: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }

  .cbf-flow-footer {
    padding: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .cbf-back-btn {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: color 0.2s ease;
    padding: 6px 0;
    font-family: var(--wb-font-body, "Helvetica Neue", Arial, sans-serif);
  }

  .cbf-back-btn:hover {
    color: #ffffff;
  }

  .cbf-submit-btn {
    flex: 1;
    background-color: #ffffff;
    color: #000000;
    border: none;
    padding: 10px 16px;
    font-size: 13px;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: opacity 0.2s ease;
    text-align: center;
    text-decoration: none;
    border-radius: 2px;
    font-family: var(--wb-font-body, "Helvetica Neue", Arial, sans-serif);
  }

  .cbf-submit-btn:hover {
    opacity: 0.9;
  }

  .cbf-submit-btn:disabled {
    background-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.4);
    cursor: not-allowed;
  }

  /* Products Container Styles */
  .cbf-products-container {
    margin-top: 40px;
    width: 100%;
  }

  .cbf-collection-products {
    width: 100%;
  }

  .cbf-products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .cbf-product-grid-item {
    width: 100%;
  }

  @media screen and (max-width: 1023px) {
    .cbf-products-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  @media screen and (max-width: 767px) {
    .cbf-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

  .cbf-no-products {
    text-align: center;
    font-size: 16px;
    color: var(--color-foreground, #000000);
    opacity: 0.6;
    margin: 40px 0;
  }

  /* Splide customization for curated section */
  .cbf-products-splide {
    position: relative;
    width: 100%;
  }

  .cbf-products-splide .splide__track {
    overflow: hidden;
  }

  .cbf-product-slide {
    width: calc((100% - 48px) / 4) !important;
  }

  @media screen and (max-width: 1023px) {
    .cbf-product-slide {
      width: calc((100% - 32px) / 3) !important;
    }
  }

  @media screen and (max-width: 767px) {
    .cbf-product-slide {
      width: calc((100% - 12px) / 2) !important;
    }
  }

  .cbf-carousel-arrows {
    display: block;
    margin: 0;
  }

  .cbf-carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: var(--color-background, #ffffff);
    border: 1px solid rgb(var(--color-border-rgb) / var(--media-border-opacity, 0.15));
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    color: var(--color-foreground, #000000);
  }

  .cbf-carousel-arrow--prev {
    left: -20px;
  }

  .cbf-carousel-arrow--next {
    right: -20px;
  }

  .cbf-carousel-arrow:hover {
    background: var(--color-foreground, #000000);
    color: var(--color-background, #ffffff);
  }

  .cbf-carousel-arrow svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
  }

  .cbf-carousel-arrow[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .cbf-section-{{ section.id }} .splide__arrow {
    top: 50%;
    transform: translateY(-50%);
  }

  .cbf-section-{{ section.id }} .splide__arrow--prev svg {
    transform: none;
  }
{%- endstyle -%}

<section class="cbf-section-{{ section.id }}" data-section-id="{{ section.id }}" id="curated-by-founder">
  <div class="cbf-container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="cbf-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="cbf-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="cbf-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cbf-grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.enable -%}
          {%- liquid
            assign tile_url = block.settings.custom_url
            if tile_url == blank and block.settings.collection != blank
              assign tile_url = block.settings.collection.url
            endif
          -%}

          {%- if block.settings.enable_interactive_flow -%}
            <div
              class="cbf-tile"
              id="cbf-block-{{ block.id }}"
              data-block-id="{{ block.id }}"
              data-collection-url="{{ tile_url | default: '#' }}"
              {{ block.shopify_attributes }}
            >
          {%- else -%}
            <a
              href="{{ tile_url | default: '#' }}"
              class="cbf-tile"
              id="cbf-block-{{ block.id }}"
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
          {%- endif -%}
            <!-- Image -->
            <div class="cbf-tile-img-wrap">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    class: 'cbf-tile-img',
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    alt: block.settings.title
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'cbf-tile-img' }}
              {%- endif -%}
            </div>

            <!-- Overlay -->
            <div class="cbf-tile-overlay"></div>

            <!-- Content -->
            <div class="cbf-tile-content">
              {%- if block.settings.collection_number != blank -%}
                <div class="cbf-tile-num">{{ block.settings.collection_number }}</div>
              {%- endif -%}
              <div class="cbf-tile-title-row">
                <h3 class="cbf-tile-title">{{ block.settings.title | default: block.settings.collection.title }}</h3>
                <span class="cbf-tile-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
              {%- if block.settings.description != blank -%}
                <p class="cbf-tile-desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>

            {%- if block.settings.enable_interactive_flow -%}
              {%- assign fit_arr = block.settings.fit_options | split: ',' -%}
              {%- assign size_arr = block.settings.size_options | split: ',' -%}
              {%- assign color_arr = block.settings.color_options | split: ',' -%}
              <div class="cbf-flow-overlay">
                <div class="cbf-flow-header">
                  <h4 class="cbf-flow-heading">{{ block.settings.title | default: block.settings.collection.title }}</h4>
                  <button type="button" class="cbf-flow-close" aria-label="Close panel">
                    <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  </button>
                </div>
                
                <div class="cbf-flow-body">
                  {%- assign step_index = 1 -%}
                  
                  {%- if block.settings.fit_options != blank -%}
                    <div class="cbf-step step-active" data-step="fit" data-param="{{ block.settings.fit_param }}">
                      <h5 class="cbf-step-title">Select Fit</h5>
                      <div class="cbf-options-list">
                        {%- for opt in fit_arr -%}
                          {%- assign opt_clean = opt | strip -%}
                          {%- if opt_clean != blank -%}
                            <button type="button" class="cbf-option-btn" data-value="{{ opt_clean }}">{{ opt_clean }}</button>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                    {%- assign step_index = step_index | plus: 1 -%}
                  {%- endif -%}

                  {%- if block.settings.size_options != blank -%}
                    <div class="cbf-step {% if step_index == 1 %}step-active{% endif %}" data-step="size" data-param="{{ block.settings.size_param }}">
                      <h5 class="cbf-step-title">Select Size</h5>
                      <div class="cbf-options-list">
                        {%- for opt in size_arr -%}
                          {%- assign opt_clean = opt | strip -%}
                          {%- if opt_clean != blank -%}
                            <button type="button" class="cbf-option-btn" data-value="{{ opt_clean }}">{{ opt_clean }}</button>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                    {%- assign step_index = step_index | plus: 1 -%}
                  {%- endif -%}

                  {%- if block.settings.color_options != blank -%}
                    <div class="cbf-step {% if step_index == 1 %}step-active{% endif %}" data-step="color" data-param="{{ block.settings.color_param }}">
                      <h5 class="cbf-step-title">Select Color</h5>
                      <div class="cbf-options-list">
                        {%- for opt in color_arr -%}
                          {%- assign opt_clean = opt | strip -%}
                          {%- if opt_clean != blank -%}
                            <button type="button" class="cbf-option-btn" data-value="{{ opt_clean }}">{{ opt_clean }}</button>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}
                </div>
                
                <div class="cbf-flow-footer">
                  <button type="button" class="cbf-back-btn" style="visibility: hidden;">Back</button>
                </div>
              </div>
            {%- endif -%}

          {%- if block.settings.enable_interactive_flow -%}
            </div>
          {%- else -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const tiles = document.querySelectorAll('.cbf-tile[data-collection-url]');
  
  tiles.forEach(tile => {
    const overlay = tile.querySelector('.cbf-flow-overlay');
    if (!overlay) return;
    
    const steps = Array.from(overlay.querySelectorAll('.cbf-step'));
    const backBtn = overlay.querySelector('.cbf-back-btn');
    const closeBtn = overlay.querySelector('.cbf-flow-close');
    
    let selections = {};
    let currentStepIndex = 0;
    
    function resetFlow() {
      selections = {};
      currentStepIndex = 0;
      steps.forEach((step, idx) => {
        step.classList.toggle('step-active', idx === 0);
        step.querySelectorAll('.cbf-option-btn').forEach(btn => btn.classList.remove('selected'));
      });
      if (backBtn) backBtn.style.visibility = 'hidden';
      tile.classList.remove('flow-active');
    }
    
    // Prevent tile click from navigating if clicking overlay elements
    tile.addEventListener('click', function(e) {
      if (e.target.closest('.cbf-flow-overlay')) {
        e.preventDefault();
        e.stopPropagation();
      } else {
        // Toggle active class on tap for mobile devices
        if (window.innerWidth <= 1024) {
          e.preventDefault();
          tile.classList.add('flow-active');
        }
      }
    });

    // Close button click
    if (closeBtn) {
      closeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        resetFlow();
      });
    }
    
    // Back button click
    if (backBtn) {
      backBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        if (currentStepIndex > 0) {
          steps[currentStepIndex].classList.remove('step-active');
          currentStepIndex--;
          steps[currentStepIndex].classList.add('step-active');
          steps[currentStepIndex].querySelectorAll('.cbf-option-btn').forEach(btn => btn.classList.remove('selected'));
          
          if (currentStepIndex === 0) {
            backBtn.style.visibility = 'hidden';
          }
        }
      });
    }
    
    // Option button clicks
    steps.forEach((step, stepIdx) => {
      const btns = step.querySelectorAll('.cbf-option-btn');
      btns.forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          // Select this button
          btns.forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          
          const param = step.dataset.param;
          const val = btn.dataset.value;
          selections[param] = val;
          
          if (stepIdx < steps.length - 1) {
            // Move to next step
            step.classList.remove('step-active');
            currentStepIndex = stepIdx + 1;
            steps[currentStepIndex].classList.add('step-active');
            
            if (backBtn) backBtn.style.visibility = 'visible';
          } else {
            // Final step: Redirect with URL parameters!
            const baseUrl = tile.dataset.collectionUrl;
            let separator = baseUrl.includes('?') ? '&' : '?';
            let paramsString = '';
            
            for (const key in selections) {
              paramsString += `${separator}${encodeURIComponent(key)}=${encodeURIComponent(selections[key])}`;
              separator = '&';
            }
            
            window.location.href = baseUrl + paramsString;
          }
        });
      });
    });
    
    // Reset flow when mouse leaves tile on desktop
    tile.addEventListener('mouseleave', function() {
      resetFlow();
    });
  });
});
</script>

{% schema %}
{
  "name": "Curated by Founder",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "CURATED BY FOUNDER"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting Text",
      "default": "Handpicked collections inspired by stories, crafted for you."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Header Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Container Width (px)",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "default": 1400
    },
