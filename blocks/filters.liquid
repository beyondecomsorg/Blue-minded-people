    <div class="collection-size-selector">
      <facets-form-component
        section-id="{{ section.id }}"
        form-style="horizontal"
        style="width: 100%; display: block;"
      >
        <form
          action="{{ results_url }}"
          id="FacetFiltersForm--{{ section.id }}-desktop"
          ref="facetsForm"
          style="width: 100%; display: block;"
        >
          <!-- White card wrapper for filters -->
          <div class="collection-size-selector-inner-card">
            <div class="collection-size-selector__main">
              {%- assign size_filter = null -%}
              {%- assign color_filter = null -%}
              {%- for filter in filters -%}
                {%- assign filter_label_downcase = filter.label | downcase -%}
                {%- if filter_label_downcase == 'size' -%}
                  {%- assign size_filter = filter -%}
                {%- elsif filter_label_downcase == 'color' or filter_label_downcase == 'colour' -%}
                  {%- assign color_filter = filter -%}
                {%- endif -%}
              {%- endfor -%}

              <!-- Row 1: Sizes on Left, Sort & Grid on Right (Desktop layout) -->
              <div class="collection-size-selector__row-1">
                <!-- Sizes Section -->
                <div class="collection-size-selector__sizes-col">
                  <div class="size-selector-card__header">
                    <div class="size-selector-card__header-left">
                      <!-- Ruler Icon for Mobile Header -->
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.3 15.3a2.82 2.82 0 0 1 0 4c-1 1-2.5 1-3.5 0L2.8 4.3a2.82 2.82 0 0 1 0-4c1-1 2.5-1 3.5 0Z"></path><path d="m5.6 7.2 1.4-1.4"></path><path d="m7.2 10.4 1.4-1.4"></path><path d="m10.4 12 1.4-1.4"></path><path d="m12 15.2 1.4-1.4"></path><path d="m15.2 16.8 1.4-1.4"></path></svg>
                      SIZE
                    </div>
                    <div class="size-selector-card__header-right mobile-only">
                      <span>View all</span>
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </div>
                  </div>

                  {%- if size_filter -%}
                    {%- assign sorted_values_str = '' -%}
                    {%- for value in size_filter.values -%}
                      {%- assign val_downcase = value.label | downcase | strip -%}
                      {%- assign weight = 99999 -%}

                      {%- if val_downcase == 'xxs' -%}
                        {%- assign weight = 100 -%}
                      {%- elsif val_downcase == 'xs' -%}
                        {%- assign weight = 110 -%}
                      {%- elsif val_downcase == 's' -%}
                        {%- assign weight = 120 -%}
                      {%- elsif val_downcase == 'm' -%}
                        {%- assign weight = 130 -%}
                      {%- elsif val_downcase == 'l' -%}
                        {%- assign weight = 140 -%}
                      {%- elsif val_downcase == 'xl' -%}
                        {%- assign weight = 150 -%}
                      {%- elsif val_downcase == 'xxl' or val_downcase == '2xl' -%}
                        {%- assign weight = 160 -%}
                      {%- elsif val_downcase == 'xxxl' or val_downcase == '3xl' -%}
                        {%- assign weight = 170 -%}
                      {%- elsif val_downcase == 'xxxxl' or val_downcase == '4xl' -%}
                        {%- assign weight = 180 -%}
                      {%- elsif val_downcase == '5xl' -%}
                        {%- assign weight = 190 -%}
                      {%- elsif val_downcase == 'os' or val_downcase == 'one size' or val_downcase == 'onesize' -%}
                        {%- assign weight = 500 -%}
                      {%- else -%}
                        {%- assign num_val = val_downcase | plus: 0.0 -%}
                        {%- if num_val != 0.0 or val_downcase == '0' or val_downcase == '0.0' -%}
                          {%- assign weight = num_val | times: 100 | plus: 10000 | floor -%}
                        {%- endif -%}
                      {%- endif -%}

                      {%- comment -%} Zero-pad weight to exactly 5 digits for lexicographical sorting {%- endcomment -%}
                      {%- assign weight_str = weight | prepend: '00000' -%}
                      {%- assign weight_len = weight_str | size -%}
                      {%- assign start_idx = weight_len | minus: 5 -%}
                      {%- assign padded_weight = weight_str | slice: start_idx, 5 -%}

                      {%- assign sorted_values_str = sorted_values_str | append: padded_weight | append: '~' | append: forloop.index0 | append: '|' -%}
                    {%- endfor -%}

                    {%- assign sorted_values_arr = sorted_values_str | split: '|' | sort -%}

                    <div class="collection-size-selector__scroll-container">
                      <facet-inputs-component on:change="/updateFilters" id="facet-inputs-component-size-selector" style="width: 100%; display: block; min-width: 0 !important;">
                        <ul class="collection-size-selector__list" id="DesktopMobileSizeList">
                          {%- for item in sorted_values_arr -%}
                            {%- if item == '' -%}{%- continue -%}{%- endif -%}
                            {%- assign parts = item | split: '~' -%}
                            {%- if parts.size < 2 -%}{%- continue -%}{%- endif -%}
                            {%- assign idx = parts[1] | plus: 0 -%}
                            {%- assign value = size_filter.values[idx] -%}

                            {%- assign input_id = 'Filter-' | append: size_filter.param_name | escape | append: '-' | append: idx | replace: '.', '-' | append: '-size-selector' -%}
                            {%- assign is_disabled = false -%}
                            {%- if value.count == 0 and value.active == false -%}
                              {%- assign is_disabled = true -%}
                            {%- endif -%}

                            <li class="collection-size-selector__item">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                id="{{ input_id }}"
                                class="collection-size-selector__input"
                                {% if value.active %}checked{% endif %}
                                {% if is_disabled %}disabled{% endif %}
                                ref="facetInputs[]"
                              >
                              <label
                                class="collection-size-selector__label"
                                for="{{ input_id }}"
                              >
                                {{- value.label -}}
                              </label>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </facet-inputs-component>
                      
                      <button type="button" class="collection-size-selector__scroll-next-btn mobile-only" onclick="document.getElementById('DesktopMobileSizeList').scrollBy({ left: 120, behavior: 'smooth' });">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </button>
                    </div>
                  {%- endif -%}
                </div>

                <!-- Sorting & Grid Controls (Desktop Only placement) -->
                <div class="collection-size-selector__sort-col desktop-only">
                  <div class="size-selector-card__header">
                    <div class="size-selector-card__header-left">SORT BY</div>
                  </div>
                  <div class="collection-size-selector__sort-controls-wrapper">
                    {% if block_settings.enable_sorting %}
                      {% render 'sorting',
                        results: results,
                        sort_by: sort_by,
                        filter_style: 'horizontal',
                        suffix: 'desktop-size-selector',
                        sort_position: 'desktop',
                        should_use_select_on_mobile: false,
                        section_id: section.id
                      %}
                    {% endif %}

                    {% if block_settings.enable_grid_density %}
                      {% render 'grid-density-controls', viewport: 'desktop' %}
                    {% endif %}
                  </div>
                </div>
              </div>

              <!-- Divider Line -->
              <div class="size-selector-card__divider"></div>

              <!-- Row 2: Colors row -->
              <div class="collection-size-selector__colors-col">
                <div class="size-selector-card__header">
                  <div class="size-selector-card__header-left">
                    <!-- Palette Icon for Mobile Header -->
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 14.7255 3.09032 17.1962 4.85857 19C5.35471 19.5126 5.56847 20.2183 5.43716 20.9022L5.22896 21.9862C5.12733 22.5152 5.5843 22.9723 6.11333 22.8706L7.19733 22.6624C7.8817 22.5312 8.58737 22.7449 9.1 23.241C10.0827 24.192 11.2384 24.498 12 22Z" fill="none"></path><circle cx="7.5" cy="10.5" r="1.5" fill="currentColor"></circle><circle cx="11.5" cy="7.5" r="1.5" fill="currentColor"></circle><circle cx="16.5" cy="9.5" r="1.5" fill="currentColor"></circle></svg>
                    COLOR
                  </div>
                  <div class="size-selector-card__header-right mobile-only">
                    <span>View all</span>
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </div>
                </div>

                {%- if color_filter -%}
                  <div class="collection-color-selector__wrapper" style="width: 100% !important; min-width: 0 !important; overflow: hidden !important;">
                    <facet-inputs-component on:change="/updateFilters" id="facet-inputs-component-color-selector" style="width: 100%; display: block; min-width: 0 !important;">
                      <ul class="collection-color-selector__list">
                        {%- for value in color_filter.values -%}
                          {%- assign input_id = 'Filter-' | append: color_filter.param_name | escape | append: '-' | append: forloop.index0 | replace: '.', '-' | append: '-color-selector' -%}
                          {%- assign is_disabled = false -%}
                          {%- if value.count == 0 and value.active == false -%}
                            {%- assign is_disabled = true -%}
                          {%- endif -%}

                          {%- comment -%} Resolve Color value background using standard swatch mapping {%- endcomment -%}
                          {%- liquid
                            assign color_value = null
                            assign color_name_downcase = value.label | downcase | strip
                            
                            if settings.swatch_color_mapping != blank
                              assign mappings = settings.swatch_color_mapping | newline_to_br | split: '<br />'
                              for mapping in mappings
                                assign parts = mapping | split: ':'
                                if parts.size >= 2
                                  assign map_name = parts[0] | downcase | strip
                                  assign map_val = parts[1] | strip
                                  if map_name == color_name_downcase
                                    assign color_value = map_val
                                    break
                                  endif
                                endif
                              endfor
                            endif

                            if color_value == null
                              case color_name_downcase
                                when 'deep navy', 'navy'
                                  assign color_value = 'var(--color-deep-navy, #0B1F33)'
                                when 'indigo blue', 'indigo'
                                  assign color_value = 'var(--color-indigo-blue, #4B0082)'
                                when 'off white', 'white'
                                  assign color_value = 'var(--color-off-white, #FAF9F6)'
                                when 'raw denim blue', 'raw denim', 'denim'
                                  assign color_value = 'var(--color-raw-denim-blue, #1E3F66)'
                                when 'vintage stone', 'stone'
                                  assign color_value = 'var(--color-vintage-stone, #8A7F7C)'
                                when 'charcoal grey', 'charcoal gray', 'charcoal'
                                  assign color_value = 'var(--color-charcoal-grey, #36454F)'
                                when 'medium grey', 'medium gray', 'grey', 'gray'
                                  assign color_value = 'var(--color-medium-grey, #808080)'
                                when 'border grey', 'border gray'
                                  assign color_value = 'var(--color-border-grey, #CCCCCC)'
                                when 'copper rivet', 'copper'
                                  assign color_value = 'var(--color-copper-rivet, #B87333)'
                                else
                                  assign color_value = color_name_downcase
                              endcase
                            endif
                          -%}

                          <li class="collection-color-selector__item">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              id="{{ input_id }}"
                              class="collection-color-selector__input"
                              {% if value.active %}checked{% endif %}
                              {% if is_disabled %}disabled{% endif %}
                              ref="facetInputs[]"
                            >
                            <label
                              class="collection-color-selector__label"
                              for="{{ input_id }}"
                            >
                              <span class="collection-color-selector__circle" style="background-color: {{ color_value }};"></span>
                              <span class="collection-color-selector__text">{{- value.label -}}</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </facet-inputs-component>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>

          <!-- Desktop Footer (PRODUCTS FOUND centered below the card) -->
          <div class="size-selector-card__desktop-footer desktop-only">
            <div class="products-count-line-wrapper">
              <span class="products-count-line-text">
                {{ products_count }} PRODUCTS FOUND
              </span>
            </div>
          </div>

          <!-- Mobile Footer (PRODUCTS FOUND left, Sort & Grid right, below the card) -->
          <div class="size-selector-card__mobile-footer mobile-only" {% if collection.handle == 'test-1' %}style="justify-content: center !important;"{% endif %}>
            <div class="products-count-wrapper">
              {{ products_count }} PRODUCTS FOUND
            </div>
            
            {% unless collection.handle == 'test-1' %}
              <div class="size-selector-card__mobile-controls-group">
                {% if block_settings.enable_sorting %}
                  {% render 'sorting',
                    results: results,
                    sort_by: sort_by,
                    filter_style: 'horizontal',
                    suffix: 'mobile-size-selector',
                    sort_position: 'mobile',
                    should_use_select_on_mobile: false,
                    section_id: section.id
                  %}
                {% endif %}

                {% if block_settings.enable_grid_density %}
                  {% render 'grid-density-controls', viewport: 'mobile' %}
                {% endif %}
              </div>
            {% endunless %}
          </div>

          {% if block_settings.enable_filtering and total_active_values > 0 %}
            <div class="facets__active-chips-row flex">
              {% render 'filter-remove-buttons',
                filters: filters,
                results_url: results_url,
                show_filter_label: block_settings.show_filter_label,
                should_show_clear_all: true
              %}
            </div>
          {% endif %}
        </form>
      </facets-form-component>
    </div>
  {%- else -%}
    {% if block_settings.filter_style == 'vertical' %}
      {% # These elements are always rendered in the horizontal bar that's why we apply the .facets--horizontal class %}
      <div
        class="facets facets--horizontal facets-controls-wrapper spacing-style"
        style="{% render 'spacing-style', settings: block_settings %}{% if block_settings.text_label_case == 'uppercase' %} --facet-label-transform: uppercase;{% endif %}"
      >
        {% if block_settings.enable_filtering %}
          <h4 class="facets--filters-title">{{ 'content.filters' | t }}</h4>
        {% endif %}

        <div
          class="products-count-wrapper"
          data-testid="products-count"
        >
          <span role="status">
            {% if products_count > 25000 %}
              {{- 'content.item_count_cutoff' | t: count: 25000 -}}
            {% else %}
              {{- 'content.item_count' | t: count: products_count -}}
            {% endif %}
          </span>
        </div>

        {% if block_settings.enable_sorting %}
          {% render 'sorting',
            results: results,
            sort_by: sort_by,
            filter_style: block_settings.filter_style,
            suffix: 'desktop',
            sort_position: 'desktop',
            should_use_select_on_mobile: false,
            section_id: section.id
          %}
        {% endif %}

        {% if block_settings.enable_grid_density %}
          {% render 'grid-density-controls', viewport: 'desktop' %}
        {% endif %}
      </div>
    {% endif %}

    <div
      class="
        {% if should_show_pane == false %}
          hidden
        {% endif %}
        facets-block-wrapper
        facets-block-wrapper--{{ block_settings.filter_style }}
        {%- if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}
        {%- if block_settings.filter_width == 'full-width' %} facets-block-wrapper--full-width{% endif %}
      "
      style="
        --grid-column--desktop:
          {%- if block_settings.filter_style == 'horizontal' -%}
            var(--{{ block_settings.filter_width }})
          {%- else -%}
            2 / var(--facets-vertical-col-width)
          {%- endif -%};
        {{ facets_margin_style }}
        --facets-inner-padding-block: {{ block_settings.padding-block-start }}px {{ block_settings.padding-block-end }}px;
        --facets-inner-padding-inline: var(--padding-lg);
      "
      {{ block.shopify_attributes }}
    >
      <div
        class="facets facets--{{ block_settings.filter_style }} spacing-style"
        style="{% render 'spacing-style', settings: block_settings %}{% if block_settings.text_label_case == 'uppercase' %} --facet-label-transform: uppercase;{% endif %}"
        aria-label="{{ 'accessibility.filters' | t }}"
      >
        <facets-form-component
          class="facets__form-wrapper"
          section-id="{{ section.id }}"
          form-style="{{ block_settings.filter_style }}"
        >
          <form
            action="{{ results_url }}"
            id="FacetFiltersForm--{{ section.id }}-desktop"
            class="facets__form"
            ref="facetsForm"
          >
            {% if should_show_pane %}
              <div class="facets__main-row">
                {% if block_settings.enable_filtering %}
                  {% assign total_active_values = 0 %}

                  {% capture rendered_filters %}
                    {%- for filter in filters -%}
                      {% case filter.type %}
                        {% when 'price_range' %}
                          {%- liquid
                            if filter.min_value.value != null or filter.max_value.value != null
                              assign total_active_values = total_active_values | plus: 1
                              assign is_active = true
                            endif

                            if block_settings.filter_style != 'vertical'
                              assign should_render_clear = true
                            else
                              assign should_render_clear = false
                            endif

                            render 'price-filter', filter: filter, filter_style: block_settings.filter_style, should_render_clear: should_render_clear, id_prefix: 'horizontal'
                          -%}
                        {% else %}
                          {% liquid
                            if filter.active_values.size > 0
                              assign is_active = true
                            endif

                            assign active_value_count = filter.active_values | size
                            assign total_active_values = total_active_values | plus: active_value_count
                            if block_settings.filter_style != 'vertical'
                              assign should_render_clear = true
                            else
                              assign should_render_clear = false
                            endif
                            render 'list-filter', filter: filter, filter_style: block_settings.filter_style, active_value_count: active_value_count, should_render_clear: should_render_clear, show_swatch_label: block_settings.show_swatch_label, sectionId: section.id
                          %}
                      {% endcase %}
                    {%- endfor -%}
                  {% endcapture %}

                  <div class="facets__filters-wrapper">
                    {{ rendered_filters }}
                  </div>
                {% endif %}

                {% if block_settings.filter_style == 'horizontal' %}
                  <div
                    class="products-count-wrapper"
                    data-testid="products-count"
                  >
                    <span role="status">
                      {% if products_count > 25000 %}
                        {{- 'content.item_count_cutoff' | t: count: 25000 -}}
                      {% else %}
                        {{- 'content.item_count' | t: count: products_count -}}
                      {% endif %}
                    </span>
                  </div>

                  {% if block_settings.enable_sorting %}
                    {% render 'sorting',
                      results: results,
                      sort_by: sort_by,
                      filter_style: block_settings.filter_style,
                      suffix: 'desktop',
                      sort_position: 'desktop',
                      should_use_select_on_mobile: false,
                      section_id: section.id
                    %}
                  {% endif %}

                  {% if block_settings.enable_grid_density %}
                    {% render 'grid-density-controls', viewport: 'desktop' %}
                  {% endif %}
                {% endif %}
              </div>

              {% if block_settings.enable_filtering and total_active_values > 0 %}
                <div class="facets__active-chips-row desktop:flex hidden">
                  {% render 'filter-remove-buttons',
                    filters: filters,
                    results_url: results_url,
                    show_filter_label: block_settings.show_filter_label,
                    should_show_clear_all: true
                  %}
                </div>
              {% endif %}
            {% endif %}
          </form>
        </facets-form-component>
      </div>
    </div>

    <div
      class="facets-toggle{% if block_settings.enable_filtering == false %} facets-toggle--no-filters{% endif %}{% if block_settings.filter_style == 'horizontal' and block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}"
      style="
        --facets-inner-padding-block: {{ block_settings.padding-block-start }}px {{ block_settings.padding-block-end }}px; --facets-inner-padding-inline: var(--padding-lg);
        {{ facets_margin_style }}
      "
    >
      {% if block_settings.enable_filtering %}
        <div class="facets-toggle__wrapper">
          <button
            class="button facets-toggle__button button-unstyled button-unstyled--with-icon"
            on:click="#filters-drawer/showDialog"
            type="button"
            aria-haspopup="dialog"
          >
            <span class="svg-wrapper">
              <svg class="icon-menu-filter" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"></circle>
                <line x1="8" y1="12" x2="16" y2="12"></line>
              </svg>
            </span>

            <span class="facets-toggle__text">Filter</span>

            <span class="facets-toggle__results-count">
              {% if products_count > 25000 %}
                {{- 'content.item_count_cutoff' | t: count: 25000 -}}
              {% else %}
                {{ products_count }} Results
              {% endif %}
            </span>

            {% if total_active_values > 0 %}
              <div
                id="filter-count-bubble-toggle"
                class="filter-count-bubble"
                aria-label="{{ 'accessibility.filter_count' | t: count: total_active_values }}"
              >
                <span class="filter-count-bubble__background"></span>

                <span
                  ref="cartBubbleText"
                  class="filter-count-bubble__text"
                  aria-hidden="true"
                >
                  {{ total_active_values }}
                </span>
              </div>
            {% endif %}
          </button>
        </div>
      {% endif %}

      {% liquid
        assign child_count = 0
        if block_settings.enable_sorting
          assign child_count = child_count | plus: 1
        endif
      %}

      <div class="facets-mobile-wrapper facets-controls-wrapper{% if child_count > 1 %} facets-mobile-wrapper--multiple-controls{% endif %}">
        {% if block_settings.enable_sorting %}
          <facets-form-component
            section-id="{{ section.id }}"
            id="FacetFiltersForm--{{ section.id }}-mobile-sorting"
          >
            <form
              action="{{ results_url }}"
              id="FacetFiltersForm--{{ section.id }}-mobile-sorting"
              ref="facetsForm"
            >
              {% render 'sorting',
                results: results,
                sort_by: sort_by,
                filter_style: block_settings.filter_style,
                suffix: 'mobile',
                sort_position: 'mobile',
                should_use_select_on_mobile: false,
                section_id: section.id
              %}
            </form>
          </facets-form-component>
        {% endif %}
      </div>
    </div>

    {% if block_settings.enable_filtering and total_active_values > 0 %}
      <facets-form-component section-id="{{ section.id }}" id="FacetFiltersForm--{{ section.id }}-mobile-active-filters">
        <div class="facets-mobile-active-filters spacing-style desktop:hidden" style="--facets-inner-padding-inline: var(--padding-lg);">
          {% render 'filter-remove-buttons',
            filters: filters,
            results_url: results_url,
            show_filter_label: block_settings.show_filter_label,
            should_show_clear_all: true
          %}
        </div>
      </facets-form-component>
    {% endif %}
  {%- endif -%}
{% else %}
  <div></div>
{% endif %}

{% if block_settings.enable_filtering and template.suffix != 'size-selector' %}
  <dialog-component
    id="filters-drawer"
    class="facets-block-wrapper facets-block-wrapper--vertical color-{{ settings.drawer_color_scheme }}"
  >
    <dialog
      ref="dialog"
      class="facets facets--drawer dialog-modal drawer dialog-drawer dialog-drawer--right spacing-style"
      style="{% render 'spacing-style', settings: block_settings %}"
      scroll-lock
      aria-labelledby="filters-drawer-heading"
    >
      {% assign form_component = 'FacetFiltersFormComponent--' | append: section.id | append: '-overflow' %}
      <facets-form-component
        class="facets__form-wrapper facets-drawer__form-wrapper"
        section-id="{{ section.id }}"
        id="{{ form_component }}"
      >
        <form
          action="{{ results_url }}"
          id="FacetFiltersForm--{{ section.id }}-overflow"
          class="facets__form"
          ref="facetsForm"
        >
          <div
            class="facets__title-wrapper"
            style="--color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));"
          >
            <h2
              id="filters-drawer-heading"
              class="facets-drawer__title h3"
            >
              {{ 'blocks.filter' | t }}

              {% if total_active_values > 0 %}
                <span
                  class="bubble facets__bubble"
                  aria-hidden="true"
                >
                  {{ total_active_values }}
                </span>
                <span class="visually-hidden">
                  {{ 'accessibility.filter_count' | t: count: total_active_values }}
                </span>
              {% endif %}
            </h2>
            <button
              class="facets-drawer__close button-unstyled close-button"
              on:click="dialog-component/closeDialog"
              type="button"
              aria-label="{{ 'actions.close' | t }}"
              autofocus
            >
              <span class="svg-wrapper svg-wrapper--small">
                {{ 'icon-close.svg' | inline_asset_content }}
              </span>
            </button>
          </div>

          <scroll-hint
            class="facets-drawer__filters"
          >
            {% if block_settings.enable_filtering %}
              {% render 'filter-remove-buttons',
                filters: filters,
                results_url: results_url,
                show_filter_label: block_settings.show_filter_label,
                should_show_clear_all: false
              %}

              <div class="facets__filters-wrapper">
                {% assign total_active_values = 0 %}
                {% assign is_active = false %}

                {%- for filter in filters -%}
                  {% case filter.type %}
                    {% when 'price_range' %}
                      {%- liquid
                        if filter.min_value.value != null or filter.max_value.value != null
                          assign total_active_values = total_active_values | plus: 1
                          assign is_active = true
                        endif

                        render 'price-filter', filter: filter, filter_style: 'vertical', should_render_clear: false, id_prefix: 'dialog', in_drawer: true
                      -%}
                    {% else %}
                      {% liquid
                        if filter.active_values.size > 0
                          assign is_active = true
                        endif

                        assign active_value_count = filter.active_values | size
                        assign total_active_values = total_active_values | plus: active_value_count
                        render 'list-filter', filter: filter, filter_style: 'vertical', active_value_count: active_value_count, should_render_clear: false, in_drawer: true, sectionId: section.id
                      %}
                  {% endcase %}
                {%- endfor -%}
              </div>
            {% endif %}

            {% if block_settings.enable_sorting %}
              {% render 'sorting',
                results: results,
                sort_by: sort_by,
                filter_style: block_settings.filter_style,
                suffix: 'overflow',
                should_use_select_on_mobile: should_use_select_on_mobile,
                section_id: section.id
              %}
            {% endif %}
          </scroll-hint>
        </form>
      </facets-form-component>

      <div
        class="facets__drawer-actions"
      >
        <facet-remove-component
          data-url="{{ results_url }}"
          active-class="facets__clear-all--active"
        >
          <button
            type="button"
            class="button-secondary facets__clear-all{% if is_active %} facets__clear-all--active{% endif %}"
            ref="clearButton"
            on:click="/removeFilter?form={{ form_component }}"
            on:keydown="/removeFilter?form={{ form_component }}"
          >
            {{- 'actions.clear_all' | t -}}
          </button>
        </facet-remove-component>

        {% if products_count > 0 %}
          <button
            class="button facets__see-results"
            type="button"
            on:click="dialog-component/closeDialog"
          >
            {{- 'actions.see_items' | t: count: products_count -}}
          </button>
        {% endif %}
      </div>
    </dialog>
  </dialog-component>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initMobileAccordions = () => {
      const drawerDetails = document.querySelectorAll('#filters-drawer details');
      drawerDetails.forEach(details => {
        if (window.innerWidth < 750) {
          details.setAttribute('name', 'mobile-filter-accordion');
        }
        
        details.addEventListener('toggle', (e) => {
          if (window.innerWidth >= 750) return;
          if (details.open) {
            drawerDetails.forEach(otherDetails => {
              if (otherDetails !== details && otherDetails.open) {
                otherDetails.removeAttribute('open');
                otherDetails.open = false;
              }
            });
          }
        });
      });
    };
    
    initMobileAccordions();
    
    // Hook into AJAX updates
    const observer = new MutationObserver((mutations) => {
      initMobileAccordions();
    });
    const formWrapper = document.querySelector('facets-form-component');
    if (formWrapper) {
      observer.observe(formWrapper, { childList: true, subtree: true });
    }
  });
</script>

{% stylesheet %}
  .facets-block-wrapper {
